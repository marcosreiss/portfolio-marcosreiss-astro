
---
interface Props {
  images: {
    src: string;
    alt: string;
  }[];
}

const { images } = Astro.props;
---

{images.length > 0 && (
  <section class="mt-16 sm:mt-24">
    <div class="mb-8">
      <span class="font-mono text-[10px] tracking-wider text-muted">
        GALERIA DO PROJETO
      </span>

      <h2 class="mt-3 font-heading text-2xl font-semibold sm:text-3xl">
        Detalhes da implementação
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      {images.map((image, index) => (
        <figure class:list={[
          "overflow-hidden bg-foreground/5",
          index === 0 && images.length % 2 !== 0 ? "md:col-span-2" : "",
        ]}>
          <img
            src={image.src}
            alt={image.alt}
            loading="lazy"
            class="h-auto w-full object-cover"
          />

          {image.alt && (
            <figcaption class="border-t border-border px-4 py-3 text-xs text-muted">
              {image.alt}
            </figcaption>
          )}
        </figure>
      ))}
    </div>
  </section>
)}
