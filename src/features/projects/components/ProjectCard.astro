---
// src/features/projects/components/ProjectCard.astro

import type { ProjectListItem } from "../lib/get-projects-list";
import {
  projectsListCopy,
  type ProjectsLang,
} from "../data/projects-list";

interface Props {
  project: ProjectListItem;
  lang: ProjectsLang;
  priority?: boolean;
}

const { project, lang, priority = false } = Astro.props;
const copy = projectsListCopy[lang];

const titleId = `catalog-project-${project.id}`;
---

<li
  class="pc-item"
  data-project-item
  data-category={project.category}
  data-search={project.searchText}
>
  <article
    class:list={["pc-card", { "pc-card--linked": Boolean(project.href) }]}
    aria-labelledby={titleId}
  >
    <div class="pc-media">
      {
        project.image ? (
          <img
            src={project.image}
            alt={project.imageAlt}
            width="1440"
            height="900"
            loading={priority ? "eager" : "lazy"}
            decoding="async"
          />
        ) : (
          <div class="pc-placeholder">
            <span>{copy.imageFallback}</span>
            <p>{project.title}</p>
          </div>
        )
      }

      {project.featured && <span class="pc-featured">{copy.featured}</span>}
    </div>

    <div class="pc-meta">
      <span>{copy.categories[project.category]}</span>
      <span class="pc-status" data-status={project.status}>
        <i aria-hidden="true"></i>
        {copy.status[project.status]}
      </span>
    </div>

    <div class="pc-title-row">
      <h2 id={titleId}>
        {
          project.href ? (
            <a
              href={project.href}
              target={project.external ? "_blank" : undefined}
              rel={project.external ? "noopener noreferrer" : undefined}
            >
              {project.title}
              <span class="pc-arrow" aria-hidden="true">↗</span>
            </a>
          ) : (
            project.title
          )
        }
      </h2>

      {project.year && <span class="pc-year">{project.year}</span>}
    </div>

    <p class="pc-subtitle">{project.subtitle}</p>

    {
      project.stack.length > 0 && (
        <ul class="pc-stack" aria-label={lang === "en" ? "Technologies" : "Tecnologias"}>
          {project.stack.slice(0, 4).map((technology) => (
            <li>{technology}</li>
          ))}
        </ul>
      )
    }

    <p class="pc-action" aria-hidden={project.href ? "true" : undefined}>
      {
        project.href
          ? project.external
            ? copy.external
            : copy.details
          : copy.unavailable
      }
    </p>
  </article>
</li>