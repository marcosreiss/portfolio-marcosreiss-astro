---
// src/features/projects/components/ProjectCard.astro

import type { CollectionEntry } from "astro:content";
import type { Language } from "../../../i18n/ui";
import { useTranslations } from "../../../i18n/utils";

interface Props {
  project: CollectionEntry<"projects">;
  lang?: Language;
}

const { project, lang = "pt-br" } = Astro.props;

const { data, id } = project;
const t = useTranslations(lang);

const localized = lang === "en"
  ? data.presentation
  : data.apresentacao;

const title = lang === "en"
  ? data.presentation.title
  : data.title;

const isDetailed = data.kind === "detailed";

const href = isDetailed
  ? lang === "en"
    ? `/en/projects/${id}/`
    : `/projetos/${id}/`
  : data.links.liveUrl || undefined;

const external = !isDetailed && Boolean(data.links.liveUrl);
---

<article class="group min-w-0">
  <div class="relative aspect-video overflow-hidden bg-foreground/5">
    {data.thumb.desktop && (
      <img
        src={data.thumb.desktop}
        alt={title}
        loading="lazy"
        class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.035]"
      />
    )}

    {href && (
      <a
        href={href}
        target={external ? "_blank" : undefined}
        rel={external ? "noopener noreferrer" : undefined}
        aria-label={`${isDetailed ? t.projects.viewCase : t.projects.visit}: ${title}`}
        class="absolute inset-0 z-10"
      >
        <span class="absolute bottom-4 right-4 translate-y-2 bg-background px-4 py-3 text-xs font-semibold text-foreground opacity-0 transition-all duration-200 group-hover:translate-y-0 group-hover:opacity-100">
          {isDetailed ? t.projects.viewCase : t.projects.visit} ↗
        </span>
      </a>
    )}
  </div>

  <div class="flex flex-col gap-4 pt-5">
    <div>
      <span class="font-mono text-[10px] tracking-wider text-primary">
        {isDetailed ? t.projects.caseStudy : t.projects.external}
      </span>

      <h2 class="mt-2 font-heading text-xl font-semibold sm:text-2xl">
        {href ? (
          <a
            href={href}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener noreferrer" : undefined}
            class="transition-colors hover:text-primary"
          >
            {title}
          </a>
        ) : (
          title
        )}
      </h2>

      <p class="mt-1 text-sm leading-6 text-muted">
        {localized.subtitle}
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      {data.stack.slice(0, 5).map((technology) => (
        <span class="border border-border px-2 py-1.5 font-mono text-[9px] text-muted">
          {technology}
        </span>
      ))}
    </div>
  </div>
</article>