---
/* src/features/home/components/Contact.astro */

import type { Language } from "@/i18n/ui";
import { getHomeTranslations } from "@/features/home/i18n";
import { siteSettings } from "@/data/site-settings";
import MotionReveal from "@/components/ui/motion/MotionReveal.astro";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { contact } = getHomeTranslations(lang);

const { email, whatsapp, whatsappMessage } = siteSettings.contact;

const whatsappNumber = whatsapp?.replace(/\D/g, "");

const whatsappUrl = whatsappNumber
  ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
      whatsappMessage || ""
    )}`
  : undefined;

const emailUrl = email ? `mailto:${email}` : undefined;
---

<section
  id="contato"
  aria-labelledby="contact-title"
  class="relative overflow-hidden bg-primary text-on-primary"
>
  <div class="relative mx-auto w-full max-w-7xl px-5 py-20 sm:px-8 md:py-28 lg:px-12">
    <MotionReveal className="mx-auto flex max-w-4xl flex-col items-center text-center">
      <span
        class="mb-6 text-xs font-semibold tracking-[0.2em] text-on-primary/70"
      >
        {contact.eyebrow}
      </span>

      <h2
        id="contact-title"
        class="max-w-3xl text-4xl font-semibold leading-tight tracking-tight sm:text-5xl lg:text-6xl"
      >
        {contact.title}
      </h2>

      <p
        class="mt-7 max-w-2xl text-base leading-relaxed text-on-primary/75 sm:text-lg"
      >
        {contact.description}
      </p>

      <div class="mt-10 flex w-full flex-col items-center justify-center gap-4 sm:w-auto sm:flex-row">
        {whatsappUrl && (
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "inline-flex w-full items-center justify-center gap-3",
              "rounded-full bg-accent px-7 py-4",
              "text-sm font-semibold text-on-accent",
              "transition-all duration-300",
              "hover:-translate-y-1 hover:shadow-xl",
              "focus-visible:outline-2 focus-visible:outline-offset-4",
              "focus-visible:outline-ring",
              "sm:w-auto",
            ]}
          >
            <span>{contact.whatsapp}</span>
            <span aria-hidden="true">↗</span>
          </a>
        )}

        {emailUrl && (
          <a
            href={emailUrl}
            class:list={[
              "inline-flex w-full items-center justify-center gap-3",
              "rounded-full border border-on-primary/30",
              "px-7 py-4 text-sm font-semibold",
              "text-on-primary transition-all duration-300",
              "hover:-translate-y-1 hover:border-on-primary",
              "hover:bg-on-primary/10",
              "sm:w-auto",
            ]}
          >
            <span>{contact.email}</span>
            <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </MotionReveal>
  </div>
</section>
