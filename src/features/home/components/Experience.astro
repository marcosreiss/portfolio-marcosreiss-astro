
---
import Container from "../../../components/ui/Container.astro";
---

<section id="experiencia" class="border-t border-border py-20 sm:py-28">
  <Container>
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div>
        <span class="font-mono text-[11px] tracking-wider text-muted">
          05 / TRAJETÓRIA
        </span>

        <h2 class="mt-5 font-heading text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">
          Experiência construída <span class="text-primary">na prática.</span>
        </h2>
      </div>

      <article class="border-t border-border py-7">
        <span class="font-mono text-[10px] tracking-wider text-muted">
          EXPERIÊNCIA PROFISSIONAL
        </span>

        <h3 class="mt-5 font-heading text-2xl font-semibold">
          Midas Tecnologia
        </h3>

        <p class="mt-3 max-w-xl text-sm leading-7 text-muted">
          Atuação no desenvolvimento de aplicações e soluções tecnológicas,
          trabalhando com tecnologias do ecossistema Java e JavaScript.
        </p>
      </article>
    </div>
  </Container>
</section>
