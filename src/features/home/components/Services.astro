
---
/* src/features/home/components/Services.astro */

import MotionReveal from "@/components/ui/motion/MotionReveal.astro";
import MotionGroup from "@/components/ui/motion/MotionGroup.astro";
import { getHomeTranslations } from "@/features/home/i18n";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const { services } = getHomeTranslations(lang);
const serviceItems = Object.values(services.items);
---

<section
  id="servicos"
  aria-labelledby="services-title"
  class="relative overflow-hidden py-24 sm:py-32"
>
  <div class="mx-auto w-full max-w-7xl px-6 lg:px-8">
    <div
      class:list={[
        "grid grid-cols-1 gap-12",
        "lg:grid-cols-[0.8fr_1.2fr] lg:gap-20",
      ]}
    >
      <div class="max-w-xl">
        <MotionReveal variant="fade-up" intensity="subtle">
          <span
            class:list={[
              "font-mono text-xs uppercase tracking-[0.2em]",
              "text-primary",
            ]}
          >
            {services.eyebrow}
          </span>
        </MotionReveal>

        <MotionReveal variant="fade-up" delay={100} intensity="subtle">
          <h2
            id="services-title"
            class:list={[
              "mt-5 text-3xl font-semibold tracking-tight",
              "text-foreground sm:text-4xl lg:text-5xl",
            ]}
          >
            {services.title}
          </h2>
        </MotionReveal>

        <MotionReveal variant="fade-up" delay={180} intensity="subtle">
          <p
            class:list={[
              "mt-6 max-w-lg text-base leading-7",
              "text-muted-foreground sm:text-lg",
            ]}
          >
            {services.description}
          </p>
        </MotionReveal>

        <MotionReveal variant="fade-up" delay={260} intensity="subtle">
          <a
            href="#contato"
            class:list={[
              "group mt-8 inline-flex items-center gap-3",
              "text-sm font-medium text-foreground",
              "transition-colors hover:text-primary",
            ]}
          >
            {services.cta}
            <span
              aria-hidden="true"
              class:list={[
                "transition-transform duration-300",
                "group-hover:translate-x-1",
              ]}
            >
              →
            </span>
          </a>
        </MotionReveal>
      </div>

      <MotionGroup
        as="div"
        variant="fade-up"
        stagger={100}
        className="grid gap-0"
      >
        {serviceItems.map((service) => (
          <article
            class:list={[
              "grid grid-cols-[2.5rem_1fr] gap-5",
              "border-t border-border py-8",
              "last:border-b",
            ]}
          >
            <span
              class:list={[
                "pt-1 font-mono text-xs tabular-nums",
                "text-muted-foreground",
              ]}
            >
              {service.number}
            </span>

            <div>
              <h3
                class:list={[
                  "text-xl font-medium tracking-tight",
                  "text-foreground sm:text-2xl",
                ]}
              >
                {service.title}
              </h3>

              <p
                class:list={[
                  "mt-2 text-sm font-medium leading-6",
                  "text-primary sm:text-base",
                ]}
              >
                {service.highlight}
              </p>

              <p
                class:list={[
                  "mt-3 max-w-xl text-sm leading-7",
                  "text-muted-foreground sm:text-base",
                ]}
              >
                {service.description}
              </p>
            </div>
          </article>
        ))}
      </MotionGroup>
    </div>
  </div>
</section>
