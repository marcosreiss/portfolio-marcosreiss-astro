
---
import Container from "../../../components/ui/Container.astro";

const services = [
  {
    number: "01",
    title: "Sites e landing pages",
    description:
      "Presença digital profissional, experiências responsivas e páginas focadas em conversão.",
  },
  {
    number: "02",
    title: "Sistemas web",
    description:
      "Aplicações personalizadas para resolver problemas reais e otimizar processos.",
  },
  {
    number: "03",
    title: "APIs e integrações",
    description:
      "Backends, integrações entre plataformas e automações para conectar seus sistemas.",
  },
  {
    number: "04",
    title: "Plataformas digitais",
    description:
      "Soluções escaláveis, painéis administrativos e produtos digitais sob medida.",
  },
];
---

<section id="servicos" class="border-t border-border py-20 sm:py-28">
  <Container>
    <div class="mb-12 max-w-3xl sm:mb-14">
      <span class="font-mono text-[11px] tracking-wider text-muted">01 / O QUE EU FAÇO</span>

      <h2 class="mt-5 font-heading text-4xl font-semibold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
        Tecnologia aplicada a <span class="text-primary">problemas reais.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 border-l border-t border-border sm:grid-cols-2 lg:grid-cols-4">
      {services.map((service) => (
        <article class="group relative min-h-56 border-b border-r border-border p-6 transition-colors hover:bg-primary/3 sm:p-7">
          <span class="font-mono text-[11px] text-primary">{service.number}</span>

          <h3 class="mt-10 font-heading text-xl font-semibold">
            {service.title}
          </h3>

          <p class="mt-3 text-sm leading-7 text-muted">
            {service.description}
          </p>

          <span class="absolute right-6 top-6 text-muted transition-transform group-hover:-translate-y-1 group-hover:translate-x-1 group-hover:text-primary">
            ↗
          </span>
        </article>
      ))}
    </div>
  </Container>
</section>
