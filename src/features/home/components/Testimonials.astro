---
/* src/features/home/components/Testimonials.astro */

import { getCollection } from "astro:content";
import type { Language } from "@/i18n/ui";
import { getHomeTranslations } from "@/features/home/i18n";
import MotionReveal from "@/components/ui/motion/MotionReveal.astro";
import MotionGroup from "@/components/ui/motion/MotionGroup.astro";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { testimonials: content } = getHomeTranslations(lang);

const [entries, projects] = await Promise.all([
  getCollection(
    "testimonials",
    ({ data }) =>
      data.published &&
      data.featured
      // data.language === lang
  ),
  getCollection("projects"),
]);

const testimonials = entries
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ data }) => {
    const project = data.projectSlug
      ? projects.find(({ id }) => id === data.projectSlug)
      : undefined;

    return {
      ...data,
      projectTitle: project
        ? lang === "en"
          ? project.data.presentation.title
          : project.data.title
        : undefined,
    };
  });
---

<section
  id="depoimentos"
  aria-labelledby="testimonials-title"
  class="relative overflow-hidden py-20 md:py-28"
>
  <div class="mx-auto w-full max-w-7xl px-5 sm:px-8 lg:px-12">
    <MotionReveal className="mx-auto mb-14 max-w-3xl text-center md:mb-16">
      <span
        class="mb-4 inline-block text-xs font-semibold tracking-[0.2em] text-primary"
      >
        {content.eyebrow}
      </span>

      <h2
        id="testimonials-title"
        class="text-3xl font-semibold leading-tight tracking-tight text-foreground sm:text-4xl lg:text-5xl"
      >
        {content.title}
      </h2>

      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground md:text-lg">
        {content.description}
      </p>
    </MotionReveal>

    {testimonials.length > 0 ? (
      <MotionGroup
        variant="fade-up"
        stagger={120}
        className="grid grid-cols-1 gap-5 md:grid-cols-2"
      >
        {testimonials.map((testimonial) => (
          <article
            class:list={[
              "group relative flex h-full flex-col",
              "rounded-2xl border border-border",
              "bg-card p-6 transition-all duration-300",
              "hover:-translate-y-1 hover:border-primary/30",
              "hover:shadow-lg hover:shadow-primary/5",
              "sm:p-8",
            ]}
          >
            <div class="mb-6 flex items-center justify-between">
              <span
                aria-hidden="true"
                class="font-serif text-6xl leading-none text-primary/40"
              >
                “
              </span>

              <span
                class="text-xs font-medium tracking-wider text-muted-foreground"
              >
                {String(testimonial.order).padStart(2, "0")}
              </span>
            </div>

            <blockquote
              class="flex-1 text-base leading-relaxed text-foreground/90 sm:text-lg"
            >
              {testimonial.quote}
            </blockquote>

            <footer class="mt-8 border-t border-border pt-6">
              <div class="flex items-center gap-4">
                {testimonial.avatar ? (
                  <img
                    src={testimonial.avatar}
                    alt=""
                    loading="lazy"
                    class="size-12 shrink-0 rounded-full object-cover"
                  />
                ) : (
                  <div
                    aria-hidden="true"
                    class="flex size-12 shrink-0 items-center justify-center rounded-full bg-primary/10 text-lg font-semibold text-primary"
                  >
                    {testimonial.name.charAt(0).toUpperCase()}
                  </div>
                )}

                <div class="min-w-0">
                  <p class="font-semibold text-foreground">
                    {testimonial.name}
                  </p>

                  {(testimonial.role || testimonial.company) && (
                    <p class="mt-1 text-sm text-muted-foreground">
                      {[testimonial.role, testimonial.company]
                        .filter(Boolean)
                        .join(" · ")}
                    </p>
                  )}

                  {testimonial.projectTitle && (
                    <p class="mt-1 text-xs text-muted-foreground">
                      {testimonial.projectTitle}
                    </p>
                  )}
                </div>
              </div>

              {testimonial.clientWebsite && (
                <a
                  href={testimonial.clientWebsite}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-4 inline-flex text-sm font-medium text-primary transition-colors hover:text-primary/70"
                >
                  {lang === "en" ? "Visit website" : "Visitar site"}
                  <span class="ml-1" aria-hidden="true">↗</span>
                </a>
              )}
            </footer>
          </article>
        ))}
      </MotionGroup>
    ) : (
      <div
        class="mx-auto flex max-w-xl flex-col items-center rounded-2xl border border-dashed border-border px-6 py-12 text-center"
      >
        <span
          aria-hidden="true"
          class="mb-4 font-serif text-5xl text-primary/40"
        >
          “
        </span>

        <p class="text-base leading-relaxed text-muted-foreground">
          {content.empty}
        </p>
      </div>
    )}
  </div>
</section>
