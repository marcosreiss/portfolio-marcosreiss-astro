
---
import type { CollectionEntry } from "astro:content";
import Container from "../../../components/ui/Container.astro";
import Button from "../../../components/ui/Button.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
---

<section id="projetos" class="bg-foreground py-20 text-background sm:py-28">
  <Container>
    <div class="mb-12 flex flex-col justify-between gap-5 sm:mb-14 sm:flex-row sm:items-end">
      <div>
        <span class="font-mono text-[11px] tracking-wider text-muted">
          02 / TRABALHOS SELECIONADOS
        </span>

        <h2 class="mt-5 font-heading text-4xl font-semibold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
          Projetos que <span class="text-primary">ganham vida.</span>
        </h2>
      </div>

      <span class="font-mono text-[11px] text-muted">
        {String(projects.length).padStart(2, "0")} PROJETOS
      </span>
    </div>

    {projects.length > 0 ? (
      <div class="grid grid-cols-1 gap-x-7 gap-y-12 md:grid-cols-2">
        {projects.map((project) => {
          const href = project.data.kind === "detailed"
            ? `/projetos/${project.id}/`
            : project.data.links.liveUrl || "#contato";

          const external = project.data.kind === "external" && Boolean(project.data.links.liveUrl);

          return (
            <article>
              <a
                href={href}
                target={external ? "_blank" : undefined}
                rel={external ? "noopener noreferrer" : undefined}
                class="group relative block aspect-16/10 overflow-hidden bg-[#292e39]"
              >
                <img
                  src={project.data.thumb.desktop}
                  alt={project.data.title}
                  loading="lazy"
                  class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.035]"
                />

                <span class="absolute bottom-4 right-4 bg-background px-4 py-3 text-xs font-semibold text-foreground opacity-0 transition-opacity group-hover:opacity-100">
                  Visualizar projeto ↗
                </span>
              </a>

              <div class="flex flex-col gap-4 pt-5">
                <div>
                  <span class="font-mono text-[10px] tracking-wider text-primary">
                    {project.data.kind === "detailed" ? "CASE STUDY" : "PROJETO"}
                  </span>

                  <h3 class="mt-2 font-heading text-2xl font-semibold">
                    {project.data.title}
                  </h3>

                  <p class="mt-1 text-sm leading-6 text-[#A0A5B0]">
                    {project.data.translations.pt.subtitle}
                  </p>
                </div>

                <div class="flex flex-wrap gap-2">
                  {project.data.stack.slice(0, 4).map((technology) => (
                    <span class="border border-[#454A54] px-2 py-1.5 font-mono text-[9px] text-[#C3C5CC]">
                      {technology}
                    </span>
                  ))}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <p class="text-sm text-muted">
        Os projetos selecionados serão apresentados aqui.
      </p>
    )}
  </Container>
</section>
