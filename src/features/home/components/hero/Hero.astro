---
// src/features/home/components/Hero.astro

import { siteSettings } from "@/data/site-settings";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

import Container from "@/components/ui/Container.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import MotionReveal from "@/components/ui/motion/MotionReveal.astro";

import HeroMock from "@/features/home/components/hero/HeroMock.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { personal, contact, availability } = siteSettings;

const whatsappNumber = contact.whatsapp?.replace(/\D/g, "");

const whatsappMessage =
  contact.whatsappMessage ||
  (lang === "en"
    ? "Hello! I found your portfolio and would like to discuss a project."
    : "Olá! Encontrei seu portfólio e gostaria de conversar sobre um projeto.");

const contactHref = whatsappNumber
  ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`
  : `mailto:${contact.email}`;

const projectsHref = lang === "en" ? "/en/projects/" : "/projetos/";

const availabilityLabels = {
  pt: {
    available: "Disponível para projetos",
    upcoming: "Disponível em breve",
    unavailable: "Indisponível no momento",
  },
  en: {
    available: "Available for projects",
    upcoming: "Available soon",
    unavailable: "Currently unavailable",
  },
};

const availabilityLabel =
  availabilityLabels[lang === "en" ? "en" : "pt"][availability.status];

const availabilityVariants = {
  available: "primary",
  upcoming: "accent",
  unavailable: "neutral",
} as const;

const showAvailability = availability.showBadge;
const availabilityMessage = availability.message;
---

<section
  class:list={[
    "relative z-10 flex min-h-screen items-center overflow-x-clip",
    "py-20 sm:py-24 lg:py-10",
  ]}
>
  <Container
    size="wide"
    className="grid items-center gap-10 lg:grid-cols-[minmax(0,.9fr)_minmax(0,1.1fr)] lg:gap-20"
  >
    <MotionReveal
      variant="fade-up"
      intensity="subtle"
      duration={800}
      className="relative z-2 max-w-170"
    >
      <Eyebrow className="mb-7 text-primary">
        <span class="size-2 shrink-0 rounded-full bg-primary shadow-[0_0_12px_var(--color-primary)]" />
        {t.hero.eyebrow}
      </Eyebrow>

      <h1
        class:list={[
          "m-0 font-heading font-semibold",
          "text-[clamp(2.5rem,5.2vw,5rem)]",
          "leading-[1.04] tracking-[-.065em]",
          "text-foreground",
        ]}
      >
        {t.hero.title}

        <span class="block text-primary">
          {t.hero.highlight}
        </span>
      </h1>

      <p class="mt-7 max-w-130 text-base leading-[1.8] text-muted sm:text-lg">
        {t.hero.description}
      </p>

      {showAvailability && (
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <Badge variant={availabilityVariants[availability.status]} size="md">
            <span
              class:list={[
                "mr-2 size-1.5 rounded-full",
                {
                  "bg-[#22A06B]": availability.status === "available",
                  "bg-[#E6A23C]": availability.status === "upcoming",
                  "bg-[#9298A4]": availability.status === "unavailable",
                },
              ]}
            />
            {availabilityLabel}
          </Badge>

          {availabilityMessage && (
            <span class="text-sm text-muted">
              {availabilityMessage}
            </span>
          )}
        </div>
      )}

      <div class="mt-8 flex flex-wrap gap-3 max-sm:flex-col">
        <Button
          href={contactHref}
          variant="primary"
          size="lg"
          external={Boolean(whatsappNumber)}
          className="border-accent bg-accent text-[#101216] hover:border-accent-hover hover:bg-accent-hover hover:text-[#101216] max-sm:w-full"
        >
          {t.hero.contact}
          <span aria-hidden="true">↗</span>
        </Button>

        <Button
          href={projectsHref}
          variant="secondary"
          size="lg"
          className="max-sm:w-full"
        >
          {t.hero.projects}
          <span aria-hidden="true">↓</span>
        </Button>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-3 font-mono text-[.68rem] tracking-[.04em] text-muted sm:mt-12">
        <span>{personal.professionalName}</span>

        <span class="size-1 rounded-full bg-accent" aria-hidden="true" />

        <span>{personal.professionalTitle}</span>
      </div>
    </MotionReveal>

    <div class="mx-auto w-full min-w-0 lg:mx-0 lg:w-[135%] lg:translate-y-[16%] xl:w-[145%]">
      <HeroMock />
    </div>
  </Container>
</section>
