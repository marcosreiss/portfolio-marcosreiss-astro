---
// src/features/home/components/Hero.astro

import { siteSettings } from "@/data/site-settings";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import HeroMock from "./HeroMock.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { personal, contact, availability } = siteSettings;

const whatsappNumber = contact.whatsapp?.replace(/\D/g, "");

const whatsappMessage =
  contact.whatsappMessage ||
  (lang === "en"
    ? "Hello! I found your portfolio and would like to discuss a project."
    : "Olá! Encontrei seu portfólio e gostaria de conversar sobre um projeto.");

const contactHref = whatsappNumber
  ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`
  : `mailto:${contact.email}`;

const projectsHref = lang === "en" ? "/en/projects/" : "/projetos/";

const availabilityLabels = {
  pt: {
    available: "Disponível para projetos",
    upcoming: "Disponível em breve",
    unavailable: "Indisponível no momento",
  },
  en: {
    available: "Available for projects",
    upcoming: "Available soon",
    unavailable: "Currently unavailable",
  },
};

const availabilityLabel =
  availabilityLabels[lang === "en" ? "en" : "pt"][availability.status];

const showAvailability = availability.showBadge;

const availabilityMessage = availability.message;
---

<section class="hero">
  <div class="hero-container">
    <div class="hero-content">
      <div class="hero-eyebrow">
        <span class="eyebrow-indicator"></span>
        {t.hero.eyebrow}
      </div>

      <h1 class="hero-title">
        {t.hero.title}
        <span>{t.hero.highlight}</span>
      </h1>

      <p class="hero-description">
        {t.hero.description}
      </p>

{
  showAvailability ? (
    <div class={`availability availability-${availability.status}`}>
      <span class="availability-indicator"></span>
      <span>{availabilityLabel}</span>

      {availabilityMessage && (
        <span class="availability-message">
          — {availabilityMessage}
        </span>
      )}
    </div>
  ) : null
}

      <div class="hero-actions">
        <a
          class="hero-button hero-button-primary"
          href={contactHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.hero.contact}
          <span aria-hidden="true">↗</span>
        </a>

        <a class="hero-button hero-button-secondary" href={projectsHref}>
          {t.hero.projects}
          <span aria-hidden="true">↓</span>
        </a>
      </div>

      <div class="hero-meta">
        <span>{personal.professionalName}</span>
        <span class="meta-separator"></span>
        <span>{personal.professionalTitle}</span>
      </div>
    </div>

    <div class="hero-visual-container">
      <HeroMock />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(780px, calc(100svh - 80px));
    padding: clamp(5rem, 9vw, 8rem) 0;
    overflow: hidden;
  }

  .hero-container {
    width: min(100% - 3rem, 1280px);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 610px;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
    color: var(--color-primary, #5577ff);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
  }

  .eyebrow-indicator {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: var(--color-primary, #5577ff);
    box-shadow: 0 0 12px var(--color-primary, #5577ff);
  }

  .hero-title {
    margin: 0;
    color: var(--color-text-primary, #171b24);
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(2.8rem, 5.2vw, 5rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.065em;
  }

  .hero-title span {
    display: block;
    color: var(--color-primary, #5577ff);
  }

  .hero-description {
    max-width: 520px;
    margin: 1.75rem 0 0;
    color: var(--color-text-secondary, #747984);
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.8;
  }

  .availability {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.5rem;
    color: var(--color-text-primary, #171b24);
    font-size: 0.82rem;
  }

  .availability-indicator {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: #22a06b;
  }

  .availability-upcoming .availability-indicator {
    background: #e6a23c;
  }

  .availability-unavailable .availability-indicator {
    background: #9298a4;
  }

  .availability-message {
    color: var(--color-text-secondary, #747984);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    min-height: 52px;
    padding: 0 1.4rem;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .hero-button:hover {
    transform: translateY(-2px);
  }

  .hero-button-primary {
    color: #fff;
    background: var(--color-primary, #315cff);
  }

  .hero-button-primary:hover {
    background: var(--color-primary-hover, #244ce0);
  }

  .hero-button-secondary {
    color: var(--color-text-primary, #171b24);
    border-color: var(--color-border, #dcd9d0);
    background: transparent;
  }

  .hero-button-secondary:hover {
    border-color: var(--color-primary, #315cff);
    color: var(--color-primary, #315cff);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 3rem;
    color: var(--color-text-secondary, #747984);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
  }

  .meta-separator {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-primary, #5577ff);
  }

  .hero-visual-container {
    min-width: 0;
    width: 100%;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      padding: 5rem 0;
    }

    .hero-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .hero-content {
      max-width: 680px;
    }

    .hero-visual-container {
      max-width: 680px;
      margin-inline: auto;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 4rem 0;
    }

    .hero-container {
      width: min(100% - 2rem, 1280px);
      gap: 2.5rem;
    }

    .hero-title {
      font-size: clamp(2.5rem, 12vw, 3.5rem);
    }

    .hero-description {
      font-size: 1rem;
    }

    .hero-actions {
      flex-direction: column;
    }

    .hero-button {
      width: 100%;
    }

    .hero-meta {
      margin-top: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-button {
      transition: none;
    }
  }
</style>
