          <nav class="flex h-full items-center gap-[2.1cqw] text-[.67cqw]">
            <span class="relative flex h-full items-center text-[#D4D5D3] after:absolute after:-bottom-px after:left-0 after:right-0 after:h-0.5 after:bg-[#5577FF]">Orders</span>
            <span class="text-[#9299A5]">Customers</span>
            <span class="text-[#9299A5]">Inventory</span>
          </nav>
          <div class="ml-auto flex items-center gap-[.7cqw] text-[1.1cqw] text-[#9299A5]">
            <span>⌕</span>
            <span class="size-[2.1cqw] rounded-full border border-[#363D49] bg-[#2B303A] text-center font-mono text-[.67cqw] leading-[2.1cqw] text-[#C7CAD0]">AK</span>
