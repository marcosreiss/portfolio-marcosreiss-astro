---
// src/features/home/components/hero/HeroMock.astro

import MotionReveal from "@/components/ui/motion/MotionReveal.astro";
---

<MotionReveal variant="fade-in" intensity="subtle" duration={900} className="w-full">
  <div
    class="relative isolate aspect-6/5 w-full @container max-sm:aspect-[1/1.08]"
    role="img"
    aria-label="Composição ilustrativa de interfaces de analytics, gestão de produtos e integrações de software"
  >
    <div class="absolute inset-0 h-full w-full max-sm:h-[120.5%] max-sm:w-[120.5%] max-sm:origin-top-left max-sm:scale-[.83]">
      <!-- API integration panel -->
      <section class="absolute left-[5.08%] top-[7.6%] z-1 h-[27.8%] w-[33.83%] rotate-[2.1deg] overflow-hidden rounded-[1cqw] border border-[#303641] bg-[#181C24] text-[#E9E8E3] shadow-[0_2.25cqw_4.6cqw_#0005,0_.6cqw_1.2cqw_#0003] max-sm:left-[1%] max-sm:top-[5%] max-sm:h-[25%] max-sm:w-[43%]" aria-hidden="true">
        <header class="flex h-[13.7%] items-center border-b border-[#303641] px-[1cqw]">
          <div class="flex w-[21%] gap-[.4cqw]">
            <i class="size-[.42cqw] rounded-full bg-[#414853]"></i>
            <i class="size-[.42cqw] rounded-full bg-[#414853]"></i>
            <i class="size-[.42cqw] rounded-full bg-[#414853]"></i>
          </div>
          <div class="flex items-center gap-[.5cqw] font-mono text-[.67cqw] text-[#999FAA]">
            <span class="text-[#9AABFF]">›_</span>
            integration.ts
          </div>
          <div class="ml-auto flex items-center gap-[.4cqw] font-mono text-[.5cqw] font-medium tracking-widest text-[#747C87]">
            <i class="size-[.42cqw] rounded-full bg-[#5577FF] shadow-[0_0_0_.25cqw_#5577FF1A]"></i>
            LIVE
          </div>
        </header>

        <div class="grid h-[74.5%] grid-cols-[1.08fr_.92fr]">
          <div class="grid grid-cols-[2.3cqw_1fr] border-r border-[#303641] bg-[#161A21] pt-[1.5cqw]">
            <div class="select-none text-right font-mono text-[.67cqw] leading-[1.75cqw] text-[#505762]">
              1<br />2<br />3<br />4<br />5<br />6<br />7
            </div>
            <pre class="m-0 whitespace-pre-wrap pl-[1cqw] font-mono text-[.67cqw] leading-[1.75cqw] text-[#ADB2BB]"><code><span class="text-[#B4A8FF]">const</span> sync = <span class="text-[#B4A8FF]">await</span>
api.<span class="text-[#9AABFF]">connect</span>(&#123;
  source: <span class="text-[#E79579]">'warehouse'</span>,
  events: [<span class="text-[#E79579]">'create'</span>, <span class="text-[#E79579]">'update'</span>],
  retry: <span class="text-[#9AABFF]">true</span>
&#125;);

sync.<span class="text-[#9AABFF]">start</span>();</code></pre>
          </div>

          <div class="relative px-[1.1cqw] py-[1.4cqw]">
            <div class="absolute left-[2.55cqw] top-[28%] h-[7%] w-px bg-[#38404C] after:absolute after:bottom-px after:-left-0.5 after:size-1 after:rotate-45 after:border-b after:border-r after:border-[#68707D]"></div>
            <div class="absolute left-[2.55cqw] top-[59%] h-[7%] w-px bg-[#38404C] after:absolute after:bottom-px after:-left-0.5 after:size-1 after:rotate-45 after:border-b after:border-r after:border-[#68707D]"></div>

            <div class="absolute left-[1.5cqw] right-[1.2cqw] top-[8%] z-1 grid h-[20%] grid-cols-[2.5cqw_1fr_.5cqw] items-center rounded-[.6cqw] border border-[#303641] bg-[#1E232C] px-[.75cqw]">
              <span class="grid size-[1.9cqw] place-items-center rounded-[.4cqw] bg-[#5577FF1A] text-[1cqw] text-[#9AABFF]">▤</span>
              <div>
                <strong class="mb-[.2cqw] block text-[.58cqw] font-medium text-[#BEC1C7]">Data store</strong>
                <small class="block text-[.5cqw] text-[#858C97]">Connected</small>
              </div>
              <i class="size-[.42cqw] rounded-full bg-[#5577FF] shadow-[0_0_0_.2cqw_#5577FF1A]"></i>
            </div>

            <div class="absolute left-[1.5cqw] right-[1.2cqw] top-[39%] z-1 grid h-[20%] grid-cols-[2.5cqw_1fr_.5cqw] items-center rounded-[.6cqw] border border-[#303641] bg-[#1E232C] px-[.75cqw]">
              <span class="grid size-[1.9cqw] place-items-center rounded-[.4cqw] bg-[#5577FF1A] text-[1cqw] text-[#9AABFF]">☁</span>
              <div>
                <strong class="mb-[.2cqw] block text-[.58cqw] font-medium text-[#BEC1C7]">Edge API</strong>
                <small class="block text-[.5cqw] text-[#858C97]">24ms latency</small>
              </div>
              <i class="size-[.42cqw] rounded-full bg-[#5577FF] shadow-[0_0_0_.2cqw_#5577FF1A]"></i>
            </div>

            <div class="absolute left-[1.5cqw] right-[1.2cqw] top-[70%] z-1 grid h-[20%] grid-cols-[2.5cqw_1fr_.5cqw] items-center rounded-[.6cqw] border border-[#303641] bg-[#1E232C] px-[.75cqw]">
              <span class="grid size-[1.9cqw] place-items-center rounded-[.4cqw] bg-[#FF784F18] text-[1cqw] text-[#E79579]">⌘</span>
              <div>
                <strong class="mb-[.2cqw] block text-[.58cqw] font-medium text-[#BEC1C7]">Webhook</strong>
                <small class="block text-[.5cqw] text-[#858C97]">Listening</small>
              </div>
              <i class="size-[.42cqw] rounded-full bg-[#5577FF] shadow-[0_0_0_.2cqw_#5577FF1A]"></i>
            </div>
          </div>
        </div>

        <footer class="flex h-[11.8%] items-center justify-between border-t border-[#303641] px-[1.1cqw] font-mono text-[.5cqw] text-[#858C97]">
          <span class="flex items-center gap-[.5cqw]">
            <i class="size-[.42cqw] rounded-full bg-[#5577FF]"></i>
            All systems operational
          </span>
          <span>1,284 req/min</span>
        </footer>
      </section>

      <!-- Analytics panel -->
      <section class="absolute left-[22.33%] top-[19%] z-2 flex h-[47.2%] w-[65.83%] rotate-[-1.25deg] overflow-hidden rounded-[1.35cqw] border border-[#303641] bg-[#181C24] text-[#E9E8E3] shadow-[0_2.8cqw_5.8cqw_#0005,0_.7cqw_1.5cqw_#0003,inset_0_1px_#ffffff08] max-sm:left-[15%] max-sm:top-[22%] max-sm:h-[44%] max-sm:w-[80%]" aria-hidden="true">
        <aside class="flex w-[7.35%] shrink-0 flex-col items-center border-r border-[#303641] px-[1.15cqw] py-[2.1cqw]">
          <div class="relative mb-[3.2cqw] size-[2.4cqw]">
            <i class="absolute left-0 top-0 size-[.85cqw] rounded-[.2cqw] bg-[#5577FF]"></i>
            <i class="absolute right-0 top-0 size-[.85cqw] rounded-[.2cqw] bg-[#5577FF] opacity-55"></i>
            <i class="absolute bottom-0 left-0 size-[.85cqw] rounded-[.2cqw] bg-[#5577FF] opacity-30"></i>
          </div>
          <nav class="flex flex-col gap-[.8cqw]">
            <span class="grid size-[3cqw] place-items-center rounded-[.65cqw] bg-[#5577FF22] text-[1.45cqw] text-[#9BACFF]">▦</span>
            <span class="grid size-[3cqw] place-items-center rounded-[.65cqw] text-[1.45cqw] text-[#707785]">⌁</span>
            <span class="grid size-[3cqw] place-items-center rounded-[.65cqw] text-[1.45cqw] text-[#707785]">♙</span>
            <span class="grid size-[3cqw] place-items-center rounded-[.65cqw] text-[1.45cqw] text-[#707785]">◇</span>
          </nav>
          <span class="mt-auto grid size-[3cqw] place-items-center text-[1.45cqw] text-[#707785]">⚙</span>
        </aside>

        <div class="min-w-0 flex-1 px-[2.1cqw] py-[2.1cqw]">
          <header class="flex items-start justify-between">
            <div>
              <span class="mb-[.65cqw] block text-[.67cqw] font-semibold tracking-[.13em] text-[#9299A5]">WORKSPACE / OVERVIEW</span>
              <h2 class="m-0 text-[1.75cqw] font-semibold leading-none tracking-[-.035em]">Performance</h2>
            </div>
            <div class="flex items-center gap-[.6cqw]">
              <span class="grid size-[2.5cqw] place-items-center rounded-[.6cqw] border border-[#303641] bg-[#1B2029] text-[1.3cqw] text-[#9298A4]">⌕</span>
              <span class="relative grid size-[2.5cqw] place-items-center rounded-[.6cqw] border border-[#303641] bg-[#1B2029] text-[1.3cqw] text-[#9298A4] after:absolute after:right-[.5cqw] after:top-[.4cqw] after:size-[.42cqw] after:rounded-full after:border after:border-[#181C24] after:bg-[#FF784F]">♧</span>
              <span class="size-[2.5cqw] rounded-[.6cqw] border border-[#363D49] bg-[#2B303A] text-center font-mono text-[.67cqw] font-medium leading-[2.5cqw] text-[#C7CAD0]">MP</span>
            </div>
          </header>

          <div class="mt-[1.8cqw] grid grid-cols-3 gap-[.85cqw]">
            <div class="relative min-h-[6.4cqw] rounded-[.75cqw] border border-[#2D333E] bg-[#1B1F27] p-[1.05cqw]">
              <span class="mb-[.6cqw] block text-[.75cqw] text-[#A4AAB5]">Net revenue</span>
              <strong class="font-mono text-[1.65cqw] font-medium leading-none tracking-[-.04em]">$48.2k</strong>
              <small class="absolute right-[1.1cqw] top-[1.2cqw] rounded-[.3cqw] bg-[#5577FF18] px-[.4cqw] py-[.25cqw] font-mono text-[.67cqw] font-medium text-[#AAB9FF]">+12.8%</small>
            </div>
            <div class="relative min-h-[6.4cqw] rounded-[.75cqw] border border-[#2D333E] bg-[#1B1F27] p-[1.05cqw]">
              <span class="mb-[.6cqw] block text-[.75cqw] text-[#A4AAB5]">Active users</span>
              <strong class="font-mono text-[1.65cqw] font-medium leading-none tracking-[-.04em]">8,429</strong>
              <small class="absolute right-[1.1cqw] top-[1.2cqw] rounded-[.3cqw] bg-[#5577FF18] px-[.4cqw] py-[.25cqw] font-mono text-[.67cqw] font-medium text-[#AAB9FF]">+8.4%</small>
            </div>
            <div class="relative min-h-[6.4cqw] rounded-[.75cqw] border border-[#2D333E] bg-[#1B1F27] p-[1.05cqw]">
              <span class="mb-[.6cqw] block text-[.75cqw] text-[#A4AAB5]">Conversion</span>
              <strong class="font-mono text-[1.65cqw] font-medium leading-none tracking-[-.04em]">4.86%</strong>
              <small class="absolute right-[1.1cqw] top-[1.2cqw] rounded-[.3cqw] bg-[#272B34] px-[.4cqw] py-[.25cqw] font-mono text-[.67cqw] font-medium text-[#B1B5BC]">+0.6%</small>
            </div>
          </div>

          <div class="mt-[.85cqw] grid grid-cols-[1.72fr_.86fr] gap-[.85cqw]">
            <div class="h-[20.65cqw] overflow-hidden rounded-[.75cqw] border border-[#2D333E] bg-[#1A1E26]">
              <div class="flex h-[4.75cqw] items-start justify-between px-[1.15cqw] py-[1cqw]">
                <div>
                  <span class="mb-[.5cqw] block text-[.75cqw] font-medium text-[#B2B7C0]">Revenue growth</span>
                  <strong class="font-mono text-[1.3cqw] font-medium">$184,620</strong>
                </div>
                <span class="rounded-[.4cqw] border border-[#303641] bg-[#20252E] px-[.55cqw] py-[.4cqw] text-[.65cqw] text-[#A4AAB5]">30 days⌄</span>
              </div>

              <div class="relative h-[15cqw] pl-[3.3cqw]">
                <div class="absolute bottom-[2cqw] left-[1.1cqw] top-[.3cqw] flex flex-col justify-between font-mono text-[.58cqw] text-[#89919D]">
                  <span>60k</span><span>40k</span><span>20k</span><span>0</span>
                </div>
                <svg class="h-[11.5cqw] w-[calc(100%-.5cqw)] overflow-visible" viewBox="0 0 430 132" preserveAspectRatio="none" aria-hidden="true">
                  <defs>
                    <linearGradient id="heroChartFill" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color="#5577FF" stop-opacity=".24" />
                      <stop offset="1" stop-color="#5577FF" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                  <path d="M0 10H430M0 47H430M0 84H430M0 121H430" fill="none" stroke="#292F39" stroke-width="1" />
                  <path d="M0 111 C28 105 40 88 67 92 S105 100 126 80 S170 55 194 67 S232 88 258 56 S300 27 325 38 S365 58 386 30 S416 14 430 20 L430 132 L0 132Z" fill="url(#heroChartFill)" />
                  <path d="M0 111 C28 105 40 88 67 92 S105 100 126 80 S170 55 194 67 S232 88 258 56 S300 27 325 38 S365 58 386 30 S416 14 430 20" fill="none" stroke="#5577FF" stroke-width="2" vector-effect="non-scaling-stroke" />
                  <circle cx="386" cy="30" r="4" fill="#181C24" stroke="#5577FF" stroke-width="2" />
                </svg>
                <div class="flex justify-between pr-[.8cqw] pt-[.15cqw] font-mono text-[.58cqw] text-[#89919D]">
                  <span>May 02</span><span>May 09</span><span>May 16</span><span>May 23</span><span>May 30</span>
                </div>
              </div>
            </div>

            <div class="h-[20.65cqw] overflow-hidden rounded-[.75cqw] border border-[#2D333E] bg-[#1A1E26]">
              <div class="flex h-[4.75cqw] items-center justify-between border-b border-[#292F38] px-[1.15cqw] py-[1cqw]">
                <span class="text-[.75cqw] font-medium text-[#B2B7C0]">Live activity</span>
                <span class="text-[.8cqw] text-[#9299A5]">•••</span>
              </div>

              <div class="px-[1.05cqw]">
                <div class="grid h-[3.75cqw] grid-cols-[.75cqw_1fr_auto] items-center gap-[.6cqw] border-b border-[#282E37]">
                  <i class="size-[.5cqw] rounded-full bg-[#5577FF] shadow-[0_0_0_.25cqw_#5577FF15]"></i>
                  <div>
                    <strong class="mb-[.2cqw] block text-[.67cqw] font-medium text-[#D0D3D9]">Deployment complete</strong>
                    <small class="block text-[.58cqw] text-[#9299A5]">Production</small>
                  </div>
                  <time class="font-mono text-[.58cqw] text-[#9299A5]">2m</time>
                </div>
                <div class="grid h-[3.75cqw] grid-cols-[.75cqw_1fr_auto] items-center gap-[.6cqw] border-b border-[#282E37]">
                  <i class="size-[.5cqw] rounded-full bg-[#FF784F] shadow-[0_0_0_.25cqw_#FF784F15]"></i>
                  <div>
                    <strong class="mb-[.2cqw] block text-[.67cqw] font-medium text-[#D0D3D9]">New subscription</strong>
                    <small class="block text-[.58cqw] text-[#9299A5]">Enterprise</small>
                  </div>
                  <time class="font-mono text-[.58cqw] text-[#9299A5]">18m</time>
                </div>
                <div class="grid h-[3.75cqw] grid-cols-[.75cqw_1fr_auto] items-center gap-[.6cqw] border-b border-[#282E37]">
                  <i class="size-[.5cqw] rounded-full bg-[#A4AAB5]"></i>
                  <div>
                    <strong class="mb-[.2cqw] block text-[.67cqw] font-medium text-[#D0D3D9]">Usage threshold</strong>
                    <small class="block text-[.58cqw] text-[#9299A5]">API Gateway</small>
                  </div>
                  <time class="font-mono text-[.58cqw] text-[#9299A5]">42m</time>
                </div>
              </div>

              <div class="flex h-[2.9cqw] items-center justify-center gap-[.4cqw] text-[.67cqw] text-[#AAB9FF]">
                View all activity <span class="text-[1cqw]">→</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Product operations panel -->
      <section class="absolute left-[32.83%] top-[69%] z-3 h-[25.5%] w-[58.5%] rotate-[1.7deg] overflow-hidden rounded-[1.05cqw] border border-[#303641] bg-[#181C24] text-[#E9E8E3] shadow-[0_2.8cqw_5.8cqw_#0005,0_.7cqw_1.5cqw_#0003] max-sm:left-[25%] max-sm:top-[70%] max-sm:h-[24%] max-sm:w-[72%]" aria-hidden="true">
        <header class="flex h-[18%] items-center border-b border-[#303641] px-[1.5cqw]">
          <div class="flex w-[25%] items-center gap-[.6cqw] font-mono text-[.67cqw] font-medium tracking-widest text-[#C5C9D0]">
            <i class="size-[1.1cqw] rotate-[8deg] rounded-[.3cqw_.15cqw_.3cqw_.15cqw] border border-[#7690FF] shadow-[inset_.25cqw_-.25cqw_#5577FF]"></i>
            OPERATIONS
