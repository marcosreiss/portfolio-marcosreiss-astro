        <div class="grid h-[82%] grid-cols-[1fr_26.35%]">
          <div class="border-r border-[#303641] px-[1.5cqw] py-[1.3cqw]">
            <div class="flex h-[3.25cqw] items-start justify-between">
              <div>
                <span class="mb-[.25cqw] block text-[.5cqw] font-semibold tracking-[.13em] text-[#9299A5]">COMMERCE</span>
                <h3 class="m-0 text-[1.15cqw] font-semibold tracking-tight">Recent orders</h3>
              </div>
              <span class="flex items-center gap-[.4cqw] rounded-[.4cqw] border border-[#313742] bg-[#20242D] px-[.6cqw] py-[.4cqw] text-[.58cqw] text-[#A4AAB5]">☷ Filter</span>
            </div>

            <div class="overflow-hidden rounded-[.5cqw] border border-[#2C323C]">
              <div class="grid h-[2cqw] grid-cols-[.8fr_1.4fr_.65fr_.8fr_.7fr] items-center bg-[#20242C] px-[.8cqw] text-[.5cqw] tracking-[.08em] text-[#9299A5] uppercase">
                <span>Order</span><span>Customer</span><span>Plan</span><span>Status</span><span>Total</span>
              </div>
              <div class="grid h-[2.55cqw] grid-cols-[.8fr_1.4fr_.65fr_.8fr_.7fr] items-center border-t border-[#292F38] px-[.8cqw] text-[.58cqw] text-[#C0C4CC]">
                <span class="font-mono text-[#AAB9FF]">OR-8421</span><span>Aperture Studio</span><span class="text-[#A4AAB5]">Pro</span><span><i class="rounded-[.6cqw] bg-[#5577FF1C] px-[.4cqw] py-[.25cqw] text-[.5cqw] not-italic text-[#AAB9FF]">Active</i></span><span>$2,480</span>
              </div>
              <div class="grid h-[2.55cqw] grid-cols-[.8fr_1.4fr_.65fr_.8fr_.7fr] items-center border-t border-[#292F38] px-[.8cqw] text-[.58cqw] text-[#C0C4CC]">
                <span class="font-mono text-[#AAB9FF]">OR-8419</span><span>Northstar Labs</span><span class="text-[#A4AAB5]">Scale</span><span><i class="rounded-[.6cqw] bg-[#FF784F1A] px-[.4cqw] py-[.25cqw] text-[.5cqw] not-italic text-[#E58A6D]">Review</i></span><span>$4,120</span>
              </div>
              <div class="grid h-[2.55cqw] grid-cols-[.8fr_1.4fr_.65fr_.8fr_.7fr] items-center border-t border-[#292F38] px-[.8cqw] text-[.58cqw] text-[#C0C4CC]">
                <span class="font-mono text-[#AAB9FF]">OR-8416</span><span>Meridian Works</span><span class="text-[#A4AAB5]">Pro</span><span><i class="rounded-[.6cqw] bg-[#5577FF1C] px-[.4cqw] py-[.25cqw] text-[.5cqw] not-italic text-[#AAB9FF]">Active</i></span><span>$1,860</span>
              </div>
            </div>
          </div>

          <aside class="bg-[#1A1E26] px-[1.3cqw] pb-[1cqw] pt-[1.5cqw]">
            <div class="flex justify-between font-mono text-[.5cqw] font-medium tracking-widest text-[#9299A5]">
              <span>MONTHLY VOLUME</span><span>•••</span>
            </div>
            <strong class="mt-[1.4cqw] block font-mono text-[1.65cqw] font-medium tracking-[-.04em]">$86,240</strong>
            <div class="mt-[.4cqw] text-[.5cqw] text-[#9299A5]"><b class="font-medium text-[#AAB9FF]">↑ 14.2%</b> from last month</div>
            <div class="my-[.7cqw] mt-[1.1cqw] flex h-[4.6cqw] items-end gap-[.4cqw] border-b border-[#303641]">
              <i class="min-h-[.6cqw] flex-1 rounded-t-[.2cqw] bg-[#333A47] h-[38%]"></i>
