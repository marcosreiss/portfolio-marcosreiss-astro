---
/* src/features/home/components/About.astro */

import type { Language } from "@/i18n/ui";
import { getHomeTranslations } from "@/features/home/i18n";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { about } = getHomeTranslations(lang);
---

<section
  id="sobre"
  class="w-full border-t border-border/70 py-20 md:py-28"
>
  <div
    class="mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-12 px-6 md:grid-cols-[0.85fr_1.15fr] md:gap-20"
  >
    <!-- Fotografia -->
    <div class="relative mx-auto w-full max-w-md">
      <div
        class="absolute -bottom-3 -right-3 h-full w-full border border-primary/30"
        aria-hidden="true"
      ></div>

      <div class="relative aspect-9/16 overflow-hidden bg-surface">
        <img
          src="/uploads/marcos-reis-about.png"
          alt={about.imageAlt}
          class="h-full w-full object-cover object-center"
          loading="lazy"
          decoding="async"
        />
      </div>

      <span
        class="absolute -bottom-7 left-0 font-mono text-[10px] uppercase tracking-[0.2em] text-muted"
      >
        {about.imageCaption}
      </span>
    </div>

    <!-- Conteúdo -->
    <div class="flex flex-col">
      <span
        class="mb-5 font-mono text-xs uppercase tracking-[0.2em] text-primary-text"
      >
        {about.eyebrow}
      </span>

      <h2
        class="max-w-2xl font-heading text-3xl font-semibold tracking-tight text-foreground md:text-5xl"
      >
        {about.title}
      </h2>

      <div class="mt-8 flex flex-col gap-5">
        {about.paragraphs.map((paragraph) => (
          <p class="max-w-2xl text-base leading-relaxed text-muted md:text-lg">
            {paragraph}
          </p>
        ))}
      </div>

      <!-- Metadados -->
      <div
        class="mt-10 grid grid-cols-1 gap-5 border-y border-border/70 py-6 sm:grid-cols-2"
      >
        {about.metadata.map((item) => (
          <div class="flex flex-col gap-1">
            <span class="font-mono text-[10px] uppercase tracking-widest text-muted">
              {item.label}
            </span>

            <span class="text-sm font-medium text-foreground">
              {item.value}
            </span>
          </div>
        ))}
      </div>

      <!-- Redes sociais -->
      <nav
        aria-label={about.socialLabel}
        class="mt-8 flex flex-wrap items-center gap-6"
      >
        {about.links.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 text-sm font-medium text-foreground transition-colors hover:text-primary-text"
          >
            {link.label}
            <span
              aria-hidden="true"
              class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
            >
              ↗
            </span>
          </a>
        ))}
      </nav>
    </div>
  </div>
</section>
