---
// src/features/home/components/Hero.astro

import "@/features/home/components/hero/hero.css";

import { siteSettings } from "@/data/site-settings";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

import Container from "@/components/ui/Container.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";

import HeroMock from "@/features/home/components/hero/HeroMock.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { personal, contact, availability } = siteSettings;

const whatsappNumber = contact.whatsapp?.replace(/\D/g, "");

const whatsappMessage =
  contact.whatsappMessage ||
  (lang === "en"
    ? "Hello! I found your portfolio and would like to discuss a project."
    : "Olá! Encontrei seu portfólio e gostaria de conversar sobre um projeto.");

const contactHref = whatsappNumber
  ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`
  : `mailto:${contact.email}`;

const projectsHref = lang === "en" ? "/en/projects/" : "/projetos/";

const availabilityLabels = {
  pt: {
    available: "Disponível para projetos",
    upcoming: "Disponível em breve",
    unavailable: "Indisponível no momento",
  },
  en: {
    available: "Available for projects",
    upcoming: "Available soon",
    unavailable: "Currently unavailable",
  },
};

const availabilityLabel =
  availabilityLabels[lang === "en" ? "en" : "pt"][availability.status];

const availabilityVariants = {
  available: "primary",
  upcoming: "accent",
  unavailable: "neutral",
} as const;

const showAvailability = availability.showBadge;
const availabilityMessage = availability.message;

// Título "digitado": cada letra recebe seu tempo (c).
// Pausa de 2 ticks entre palavras e 6 extras antes da linha destacada.
let tick = 0;

const tokenize = (text: string, endPause: number) => {
  const words = text.trim().split(/\s+/);

  return words.map((word, idx) => {
    const items = [...word].map((ch) => ({ ch, c: tick++ }));
    tick += idx === words.length - 1 ? endPause : 2;
    return items;
  });
};

const titleWords = tokenize(t.hero.title, 6);
const highlightWords = tokenize(t.hero.highlight, 0);
const totalTicks = tick;
const fullTitle = `${t.hero.title} ${t.hero.highlight}`;
---

<section
  class:list={[
    "relative z-10 flex min-h-screen items-center overflow-x-clip",
    "py-20 sm:py-24 lg:py-10",
  ]}
>
  <!-- <div class="hv-bg" aria-hidden="true">
    <span class="hv-blob hv-blob--a"></span>
    <span class="hv-blob hv-blob--b"></span>
  </div> -->

  <Container
    size="wide"
    className="grid items-center gap-10 lg:grid-cols-[minmax(0,.9fr)_minmax(0,1.1fr)] lg:gap-20"
  >
    <!-- Coluna do texto -->
    <div data-hero-copy class="relative z-2 max-w-170">
      <Eyebrow className="hv-first mb-7 text-primary">
        <span class="hv-pulse size-2 shrink-0 rounded-full bg-primary" />
        {t.hero.eyebrow}
      </Eyebrow>

      <h1
        data-typing
        data-total={totalTicks}
        data-state="idle"
        class:list={[
          "hv-typing m-0 font-heading font-semibold",
          "text-[clamp(2.5rem,5.2vw,5rem)]",
          "leading-[1.04] tracking-[-.065em]",
          "text-foreground",
        ]}
      >
        <span class="sr-only">{fullTitle}</span>

        <span aria-hidden="true">
          {titleWords.map((word, i) => (
            <>
              <span class="hv-word">
                {word.map(({ ch, c }) => (
                  <span class="hv-ch" data-c={c}>{ch}</span>
                ))}
              </span>
              {i < titleWords.length - 1 && " "}
            </>
          ))}
        </span>

        <span class="block text-primary" aria-hidden="true">
          {highlightWords.map((word, i) => (
            <>
              <span class="hv-word">
                {word.map(({ ch, c }) => (
                  <span class="hv-ch" data-c={c}>{ch}</span>
                ))}
              </span>
              {i < highlightWords.length - 1 && " "}
            </>
          ))}
          <span class="hv-caret"></span>
        </span>
      </h1>

      <p
        class="hv-after mt-7 max-w-130 text-base leading-[1.8] text-muted sm:text-lg"
        style="--k:0"
      >
        {t.hero.description}
      </p>

      {showAvailability && (
        <div class="hv-after mt-6 flex flex-wrap items-center gap-3" style="--k:1">
          <Badge variant={availabilityVariants[availability.status]} size="md">
            <span
              class:list={[
                "hv-pulse mr-2 size-1.5 rounded-full",
                {
                  "bg-[#22A06B] [--pulse:#22A06B]": availability.status === "available",
                  "bg-[#E6A23C] [--pulse:#E6A23C]": availability.status === "upcoming",
                  "bg-[#9298A4] [--pulse:#9298A4]": availability.status === "unavailable",
                },
              ]}
            />
            {availabilityLabel}
          </Badge>

          {availabilityMessage && (
            <span class="text-sm text-muted">{availabilityMessage}</span>
          )}
        </div>
      )}

      <div class="hv-after mt-8 flex flex-wrap gap-3 max-sm:flex-col" style="--k:2">
        <Button
          href={contactHref}
          variant="primary"
          size="lg"
          external={Boolean(whatsappNumber)}
          className="hv-cta border-accent bg-accent text-[#101216] hover:border-accent-hover hover:bg-accent-hover hover:text-[#101216] max-sm:w-full"
        >
          {t.hero.contact}
          <span aria-hidden="true">↗</span>
        </Button>

        <Button
          href={projectsHref}
          variant="secondary"
          size="lg"
          className="hv-sec max-sm:w-full"
        >
          {t.hero.projects}
          <span aria-hidden="true">↓</span>
        </Button>
      </div>

      <div
        class="hv-after mt-8 flex flex-wrap items-center gap-3 font-mono text-[.68rem] tracking-[.04em] text-muted sm:mt-12"
        style="--k:3"
      >
        <span>{personal.professionalName}</span>
        <span class="size-1 rounded-full bg-accent" aria-hidden="true" />
        <span>{personal.professionalTitle}</span>
      </div>
    </div>

    <!-- Coluna do mock -->
    <div class="mx-auto w-full min-w-0 lg:mx-0 hidden lg:block">
      <HeroMock />
    </div>
  </Container>
</section>

<script>
  import "@/features/home/components/hero/scripts/hero-typing";
</script>