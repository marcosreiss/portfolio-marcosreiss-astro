---
// src/components/ui/FloatingWhatsApp.astro

import { siteSettings } from "@/data/site-settings";
import { getLangFromUrl } from "@/i18n/utils";

interface Props {
  message?: string;
  label?: string;
  delay?: number;
}

const lang = getLangFromUrl(Astro.url) === "en" ? "en" : "pt";

const defaults = {
  pt: {
    label: "Conversar com Marcos pelo WhatsApp",
    message:
      "Olá, Marcos! Vi seu portfólio e gostaria de conversar sobre um projeto.",
    hint: "Vamos conversar?",
  },
  en: {
    label: "Chat with Marcos on WhatsApp",
    message:
      "Hi Marcos! I saw your portfolio and would like to discuss a project.",
    hint: "Let's talk?",
  },
}[lang];

const {
  message = siteSettings.contact.whatsappMessage || defaults.message,
  label = defaults.label,
  delay = 5000,
} = Astro.props;

const number = siteSettings.contact.whatsapp?.replace(/\D/g, "") ?? "";

const href = number
  ? `https://wa.me/${number}?text=${encodeURIComponent(message)}`
  : undefined;

const safeDelay =
  Number.isFinite(delay) && delay >= 0 ? delay : 5000;
---

{
  href && (
    <a
      class="floating-whatsapp"
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={label}
      data-floating-whatsapp
      data-delay={safeDelay}
      hidden
    >
      <span class="floating-whatsapp-hint" aria-hidden="true">
        {defaults.hint}
      </span>

      <svg
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M20.5 11.7a8.5 8.5 0 0 1-12.6 7.5L3 20.5l1.3-4.7A8.5 8.5 0 1 1 20.5 11.7Z"
          stroke="currentColor"
          stroke-width="1.65"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="m8.2 7.5 1.2 2.4-.9 1.1a9 9 0 0 0 3.8 3.7l1.1-1 2.4 1.2c.2.1.3.3.2.5-.2 1.1-.9 1.7-2 1.7-3.6-.2-7.5-4.1-7.6-7.7 0-1 .5-1.7 1.3-2 .2-.1.4 0 .5.1Z"
          fill="currentColor"
        />
      </svg>
    </a>
  )
}

<style>
  /* src/components/ui/FloatingWhatsApp.astro — apresentação */

  .floating-whatsapp {
    --floating-whatsapp-size: 3.5rem;
    --floating-whatsapp-gap: 1.25rem;
    --floating-whatsapp-z: 40;

    position: fixed;
    right: calc(
      var(--floating-whatsapp-gap) + env(safe-area-inset-right, 0px)
    );
    bottom: calc(
      var(--floating-whatsapp-gap) + env(safe-area-inset-bottom, 0px)
    );
    z-index: var(--floating-whatsapp-z);

    display: grid;
    width: var(--floating-whatsapp-size);
    height: var(--floating-whatsapp-size);
    place-items: center;

    border: 1px solid var(--primary);
    border-radius: 50%;
    background: var(--primary);
    color: var(--on-primary);

    box-shadow:
      0 0.4rem 1.5rem
      color-mix(in srgb, var(--foreground) 18%, transparent);

    text-decoration: none;

    animation: floating-whatsapp-enter 260ms ease-out both;

    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .floating-whatsapp[hidden] {
    display: none !important;
  }

  .floating-whatsapp svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .floating-whatsapp:hover,
  .floating-whatsapp:focus-visible {
    border-color: var(--primary-hover);
    background: var(--primary-hover);
    transform: translateY(-2px);
  }

  .floating-whatsapp-hint {
    position: absolute;
    right: calc(100% + 0.75rem);
    padding: 0.55rem 0.75rem;

    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--foreground);

    font-size: 0.8rem;
    line-height: 1.5;
    white-space: nowrap;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition: opacity 150ms ease;
  }

  .floating-whatsapp:hover .floating-whatsapp-hint,
  .floating-whatsapp:focus-visible .floating-whatsapp-hint {
    opacity: 1;
    visibility: visible;
  }

  @keyframes floating-whatsapp-enter {
    from {
      opacity: 0;
      translate: 0 0.5rem;
    }

    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (max-width: 639px) {
    .floating-whatsapp {
      --floating-whatsapp-gap: 1rem;
      --floating-whatsapp-size: 3.25rem;
    }

    .floating-whatsapp-hint {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-whatsapp {
      animation: none;
      transition: none;
    }

    .floating-whatsapp:hover,
    .floating-whatsapp:focus-visible {
      transform: none;
    }

    .floating-whatsapp-hint {
      transition: none;
    }
  }
</style>

<script>
  // src/components/ui/FloatingWhatsApp.astro — comportamento

  let timers: number[] = [];

  function clearFloatingWhatsAppTimers() {
    timers.forEach((timer) => window.clearTimeout(timer));
    timers = [];
  }

  function initFloatingWhatsApp() {
    clearFloatingWhatsAppTimers();

    document
      .querySelectorAll<HTMLAnchorElement>("[data-floating-whatsapp]")
      .forEach((link) => {
        link.hidden = true;

        const rawDelay = Number(link.dataset.delay);
        const delay =
          Number.isFinite(rawDelay) && rawDelay >= 0 ? rawDelay : 5000;

        const timer = window.setTimeout(() => {
          if (link.isConnected) {
            link.hidden = false;
          }
        }, delay);

        timers.push(timer);
      });
  }

  initFloatingWhatsApp();

  document.addEventListener("astro:page-load", initFloatingWhatsApp);
  document.addEventListener(
    "astro:before-swap",
    clearFloatingWhatsAppTimers,
  );

  if (import.meta.hot) {
    import.meta.hot.dispose(() => {
      clearFloatingWhatsAppTimers();

      document.removeEventListener(
        "astro:page-load",
        initFloatingWhatsApp,
      );

      document.removeEventListener(
        "astro:before-swap",
        clearFloatingWhatsAppTimers,
      );
    });
  }
</script>