---
// src/components/ui/SectionHeading.astro

import type { HTMLTag } from "astro/types";
import Eyebrow from "./Eyebrow.astro";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  titleAs?: HTMLTag;
  align?: "left" | "center";
  size?: "default" | "large";
  className?: string;
}

const {
  eyebrow,
  title,
  description,
  titleAs: TitleTag = "h2",
  align = "left",
  size = "default",
  className = "",
} = Astro.props;

const alignments = {
  left: "text-left items-start",
  center: "text-center items-center",
};

const titleSizes = {
  default: "text-3xl sm:text-4xl lg:text-5xl",
  large: "text-4xl sm:text-5xl lg:text-6xl",
};
---

<header
  class:list={[
    "flex flex-col gap-5",
    alignments[align],
    className,
  ]}
>
  {eyebrow && (
    <Eyebrow line>
      {eyebrow}
    </Eyebrow>
  )}

  <TitleTag
    class:list={[
      "max-w-4xl font-heading font-semibold leading-[1.05]",
      "tracking-[-0.045em] text-foreground",
      titleSizes[size],
    ]}
  >
    {title}
  </TitleTag>

  {description && (
    <p
      class:list={[
        "max-w-2xl text-base leading-relaxed text-muted",
        "sm:text-lg",
        align === "center" && "mx-auto",
      ]}
    >
      {description}
    </p>
  )}
</header>