---
// src/components/ui/Button.astro
import { clsx } from "clsx";
import { twMerge } from "tailwind-merge";

interface Props {
  href: string;
  variant?: "primary" | "secondary" | "inverse" | "text" | "accent";
  size?: "sm" | "md" | "lg";
  external?: boolean;
  ariaLabel?: string;
  className?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  external = false,
  ariaLabel,
  className = "",
} = Astro.props;

const variants = {
  primary: [
    "border border-primary bg-primary text-white",
    "hover:border-foreground hover:bg-foreground hover:text-background",
  ].join(" "),

  secondary: [
    "border border-border bg-transparent text-foreground",
    "hover:border-primary hover:bg-primary hover:text-white",
  ].join(" "),

  inverse: [
    "border border-background bg-background text-primary",
    "hover:border-primary hover:bg-primary hover:text-white",
  ].join(" "),

  text: [
    "border border-transparent bg-transparent text-primary",
    "hover:text-foreground hover:underline hover:underline-offset-4",
  ].join(" "),

  accent: [
    "border border-accent bg-accent text-[#101216]",
    "hover:border-accent-hover hover:bg-accent-hover hover:text-[#101216]",
  ].join(" "),
};

const sizes = {
  sm: "min-h-10 px-4 py-2 text-xs",
  md: "min-h-12 px-5 py-3 text-sm",
  lg: "min-h-14 px-7 py-4 text-sm",
};

const baseClasses = [
  "group inline-flex items-center justify-center gap-3",
  "font-semibold",
  "transition-colors duration-200",
  "focus-visible:outline-2 focus-visible:outline-offset-4",
  "focus-visible:outline-primary",
];

const spacing = variant === "text" ? "p-0" : sizes[size];

// O twMerge vai identificar que bg-accent e bg-primary são conflitantes
// e vai remover o bg-primary do HTML final!
const finalClasses = twMerge(clsx(baseClasses, spacing, variants[variant], className));
---

<a
  href={href}
  class={finalClasses}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  aria-label={ariaLabel}
>
  <slot />
</a>