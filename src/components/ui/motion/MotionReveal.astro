---
// src/components/ui/motion/MotionReveal.astro

import { MOTION_DEFAULTS, MOTION_INTENSITIES, MOTION_VARIANTS } from "@/utils/motion/constants";
import { buildMotionStyle, oneOf, toNonNegative } from "@/utils/motion/styles";
import type { MotionRevealProps } from "@/utils/motion/types";

interface Props extends MotionRevealProps {}

const {
  as: Tag = "div",
  variant = MOTION_DEFAULTS.variant,
  intensity = MOTION_DEFAULTS.intensity,
  delay = MOTION_DEFAULTS.delay,
  duration,
  distance,
  once = MOTION_DEFAULTS.once,
  className = "",
  ...rest
} = Astro.props;

const safeVariant = oneOf(variant, MOTION_VARIANTS, MOTION_DEFAULTS.variant);
const safeIntensity = oneOf(intensity, MOTION_INTENSITIES, MOTION_DEFAULTS.intensity);

const safeDuration = toNonNegative(duration);
const safeDistance = toNonNegative(distance);

const styles = buildMotionStyle({
  "--motion-delay": `${toNonNegative(delay) ?? 0}ms`,
  "--motion-duration": safeDuration !== undefined ? `${safeDuration}ms` : undefined,
  "--motion-distance": safeDistance !== undefined ? `${safeDistance}px` : undefined,
});
---

<Tag
  {...rest}
  data-motion={safeVariant}
  data-motion-intensity={safeIntensity}
  data-motion-once={String(once)}
  style={styles}
  class:list={["motion-reveal", className]}
>
  <slot />
</Tag>

<script>
  import { initMotion } from "@/utils/motion/observer";

  initMotion();
</script>