---
// src/components/ui/motion/MotionGroup.astro

import { MOTION_DEFAULTS, MOTION_GROUP_VARIANTS } from "@/utils/motion/constants";
import { buildMotionStyle, oneOf, toNonNegative } from "@/utils/motion/styles";
import type { MotionGroupProps } from "@/utils/motion/types";

interface Props extends MotionGroupProps {}

const {
  as: Tag = "div",
  variant = MOTION_DEFAULTS.groupVariant,
  stagger = MOTION_DEFAULTS.stagger,
  delay = MOTION_DEFAULTS.delay,
  duration,
  distance,
  once = MOTION_DEFAULTS.once,
  className = "",
  ...rest
} = Astro.props;

const safeVariant = oneOf(variant, MOTION_GROUP_VARIANTS, MOTION_DEFAULTS.groupVariant);

const safeDuration = toNonNegative(duration);
const safeDistance = toNonNegative(distance);

const styles = buildMotionStyle({
  "--motion-stagger": `${toNonNegative(stagger) ?? MOTION_DEFAULTS.stagger}ms`,
  "--motion-delay": `${toNonNegative(delay) ?? 0}ms`,
  "--motion-group-duration": safeDuration !== undefined ? `${safeDuration}ms` : undefined,
  "--motion-group-distance": safeDistance !== undefined ? `${safeDistance}px` : undefined,
});
---

<Tag
  {...rest}
  data-motion-group={safeVariant}
  data-motion-once={String(once)}
  style={styles}
  class:list={["motion-group", className]}
>
  <slot />
</Tag>

<script>
  import { initMotion } from "@/utils/motion/observer";

  initMotion();
</script>