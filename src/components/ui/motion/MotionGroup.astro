---
// src/components/ui/motion/MotionGroup.astro

import type { HTMLTag } from "astro/types";

import type {
  MotionGroupVariant,
} from "../../../utils/motion/types";

interface Props {
  as?: HTMLTag;
  variant?: MotionGroupVariant;
  stagger?: number;
  delay?: number;
  duration?: number;
  distance?: number;
  once?: boolean;
  className?: string;
}

const {
  as: Tag = "div",
  variant = "fade-up",
  stagger = 80,
  delay = 0,
  duration,
  distance,
  once = true,
  className = "",
} = Astro.props;

const styles = [
  `--motion-stagger: ${Math.max(0, stagger)}ms`,
  `--motion-delay: ${Math.max(0, delay)}ms`,
  duration !== undefined
    ? `--motion-group-duration: ${Math.max(0, duration)}ms`
    : "",
  distance !== undefined
    ? `--motion-group-distance: ${Math.max(0, distance)}px`
    : "",
]
  .filter(Boolean)
  .join("; ");
---

<Tag
  data-motion-group={variant}
  data-motion-once={String(once)}
  style={styles}
  class:list={["motion-group", className]}
>
  <slot />
</Tag>

<script>
  import { initMotion } from "../../../utils/motion/observer";

  initMotion();
</script>
