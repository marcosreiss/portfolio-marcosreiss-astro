---
// src/components/ui/motion/MotionImage.astro

import { MOTION_DEFAULTS } from "@/utils/motion/constants";
import type { MotionImageProps } from "@/utils/motion/types";

interface Props extends MotionImageProps {}

const {
  reveal = true,
  hoverZoom = false,
  once = MOTION_DEFAULTS.once,
  className = "",
  ...rest
} = Astro.props;
---

<div
  {...rest}
  class:list={[
    "motion-image",
    hoverZoom && "motion-image--zoom",
    className,
  ]}
  data-motion={reveal ? "reveal-mask" : undefined}
  data-motion-once={reveal ? String(once) : undefined}
>
  <slot />
</div>

<script>
  import { initMotion } from "@/utils/motion/observer";

  initMotion();
</script>