---
// src/components/ui/Eyebrow.astro

import type { HTMLTag } from "astro/types";

interface Props {
  as?: HTMLTag;
  index?: string;
  line?: boolean;
  className?: string;
}

const {
  as: Tag = "p",
  index,
  line = false,
  className = "",
} = Astro.props;
---

<Tag
  class:list={[
    "inline-flex items-center gap-3",
    "font-mono text-[11px] font-medium uppercase tracking-[0.16em]",
    "text-muted",
    className,
  ]}
>
  {index && (
    <span class="text-primary" aria-hidden="true">
      {index}
    </span>
  )}

  {line && (
    <span
      class="h-px w-6 bg-accent"
      aria-hidden="true"
    ></span>
  )}

  <slot />
</Tag>