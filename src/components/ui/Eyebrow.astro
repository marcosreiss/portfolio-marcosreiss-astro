---
// src/components/ui/Eyebrow.astro
import type { HTMLTag } from "astro/types";
import { clsx } from "clsx";
import { twMerge } from "tailwind-merge";

interface Props {
  as?: HTMLTag;
  variant?: "default" | "primary" | "accent";
  index?: string;
  line?: boolean;
  className?: string;
}

const {
  as: Tag = "p",
  variant = "default",
  index,
  line = false,
  className = "",
} = Astro.props;

const variants = {
  default: "text-muted",
  primary: "text-primary-text",
  accent: "text-accent-text",
};

const indexVariants = {
  default: "text-primary-text",
  primary: "text-primary-text",
  accent: "text-accent-text",
};

const baseClasses = [
  "inline-flex items-center gap-3",
  "font-mono text-[11px] font-medium uppercase tracking-[0.16em]",
];

const finalClasses = twMerge(
  clsx(baseClasses, variants[variant], className)
);
---

<Tag class={finalClasses}>
  {index && (
    <span class={indexVariants[variant]} aria-hidden="true">
      {index}
    </span>
  )}

  {line && (
    <span
      class="h-px w-6 bg-accent"
      aria-hidden="true"
    ></span>
  )}

  <slot />
</Tag>
