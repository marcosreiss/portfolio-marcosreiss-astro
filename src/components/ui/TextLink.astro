---
// src/components/ui/TextLink.astro
import { clsx } from "clsx";
import { twMerge } from "tailwind-merge";

interface Props {
  href: string;
  variant?: "primary" | "accent" | "muted";
  external?: boolean;
  arrow?: boolean;
  ariaLabel?: string;
  className?: string;
}

const {
  href,
  variant = "primary",
  external = false,
  arrow = true,
  ariaLabel,
  className = "",
} = Astro.props;

const variants = {
  primary: "text-primary-text hover:text-foreground focus-visible:outline-ring",
  accent: "text-accent-text hover:text-foreground focus-visible:outline-ring",
  muted: "text-muted hover:text-foreground focus-visible:outline-ring",
};

const baseClasses = [
  "group inline-flex w-fit items-center gap-2",
  "text-sm font-semibold",
  "transition-colors duration-200",
  "focus-visible:outline-2 focus-visible:outline-offset-4",
];

const finalClasses = twMerge(
  clsx(baseClasses, variants[variant], className)
);
---

<a
  href={href}
  class={finalClasses}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  aria-label={ariaLabel}
>
  <span class="motion-underline">
    <slot />
  </span>

  {arrow && (
    <svg
      class="size-4 shrink-0 transition-transform duration-200 group-hover:translate-x-1"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M5 12h14" />
      <path d="m12 5 7 7-7 7" />
    </svg>
  )}
</a>
