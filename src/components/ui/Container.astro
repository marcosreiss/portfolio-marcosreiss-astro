---
// src/components/ui/Container.astro

interface Props {
  size?: "narrow" | "default" | "wide";
  className?: string;
}

const {
  size = "default",
  className = "",
} = Astro.props;

const sizes = {
  narrow: "max-w-[960px]",
  default: "max-w-[1200px]",
  wide: "max-w-[1440px]",
};
---

<div
  class:list={[
    "mx-auto w-full px-4 sm:px-6 lg:px-8",
    sizes[size],
    className,
  ]}
>
  <slot />
</div>