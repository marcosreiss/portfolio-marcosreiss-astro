---
// src/components/ui/Container.astro
import { clsx } from "clsx";
import { twMerge } from "tailwind-merge";

interface Props {
  size?: "narrow" | "default" | "wide";
  className?: string;
}

const {
  size = "default",
  className = "",
} = Astro.props;

const sizes = {
  narrow: "max-w-[960px]",
  default: "max-w-[1200px]",
  wide: "max-w-[1440px]",
};

const baseClasses = "mx-auto w-full px-4 sm:px-6 lg:px-8";

const finalClasses = twMerge(clsx(baseClasses, sizes[size], className));
---

<div class={finalClasses}>
  <slot />
</div>