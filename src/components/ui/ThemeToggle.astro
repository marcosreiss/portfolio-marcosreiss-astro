---
// src/components/ui/ThemeToggle.astro

interface Props {
  labelLight?: string;
  labelDark?: string;
}

const {
  labelLight = "Ativar tema claro",
  labelDark = "Ativar tema escuro",
} = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  data-label-light={labelLight}
  data-label-dark={labelDark}
  class="group grid size-10 shrink-0 place-items-center border border-border text-foreground transition-colors hover:border-primary hover:text-primary-text active:scale-95"
  aria-label="Alternar tema"
  title="Alternar tema"
  aria-pressed="false"
>
  <span class="relative flex size-4 items-center justify-center">
    <!-- Sol: aparece no tema escuro -->
    <svg
      class="absolute size-4 rotate-90 scale-0 transition-all duration-300 dark:rotate-0 dark:scale-100"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
    </svg>

    <!-- Lua: aparece no tema claro -->
    <svg
      class="absolute size-4 rotate-0 scale-100 transition-all duration-300 dark:-rotate-90 dark:scale-0"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6.5 6.5 0 0 0 8.268 8.268c.344-.215.825-.003.803.401" />
    </svg>
  </span>
</button>
