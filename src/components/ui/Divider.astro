---
// src/components/ui/Divider.astro
import { clsx } from "clsx";
import { twMerge } from "tailwind-merge";

interface Props {
  orientation?: "horizontal" | "vertical";
  color?: "default" | "primary" | "accent";
  className?: string;
}

const {
  orientation = "horizontal",
  color = "default",
  className = "",
} = Astro.props;

const colors = {
  default: "border-border bg-border",
  primary: "border-primary bg-primary",
  accent: "border-accent bg-accent",
};

const orientationClasses =
  orientation === "horizontal"
    ? "w-full border-0 border-t"
    : "block h-full min-h-6 w-px shrink-0";

const finalClasses = twMerge(
  clsx(orientationClasses, colors[color], className)
);
---

{orientation === "horizontal" ? (
  <hr class={finalClasses} aria-hidden="true" />
) : (
  <span class={finalClasses} aria-hidden="true"></span>
)}