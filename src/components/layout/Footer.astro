
---
import Container from "../ui/Container.astro";
import { useTranslations } from "../../i18n/utils";
import type { Language } from "../../i18n/ui";

interface Props {
  lang?: Language;
}

const { lang = "pt-br" } = Astro.props;
const t = useTranslations(lang);
const homePath = lang === "en" ? "/en/" : "/";
---

<footer class="border-t border-border py-12">
  <Container>
    <div class="flex flex-col justify-between gap-8 pb-10 sm:flex-row sm:items-start">
      <div>
        <a href={homePath} class="font-heading text-2xl font-bold">
          marcos<span class="text-primary">.</span>reis
        </a>

        <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted">
          {t.footer.description}
        </p>
      </div>

      <nav class="flex flex-wrap gap-x-6 gap-y-3" aria-label="Redes sociais">
        <a
          href="https://github.com/marcosreiss"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium transition-colors hover:text-primary"
        >
          GitHub ↗
        </a>

        <a
          href="https://www.linkedin.com/in/marcosvinireis/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium transition-colors hover:text-primary"
        >
          LinkedIn ↗
        </a>

        <a
          href="mailto:marcosvinireiss@gmail.com"
          class="text-sm font-medium transition-colors hover:text-primary"
        >
          Email ↗
        </a>
      </nav>
    </div>

    <div class="flex flex-col justify-between gap-3 border-t border-border pt-5 font-mono text-[10px] text-muted sm:flex-row">
      <span>© {new Date().getFullYear()} Marcos Reis</span>
      <span>{t.footer.tagline}</span>
    </div>
  </Container>
</footer>
