---
// Caminho: src/components/layout/Footer.astro

import { siteSettings } from '@/data/site-settings';
import type { Language } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import Container from '../ui/Container.astro';


interface Props {
  lang?: Language;
}

const { lang = "pt-br" } = Astro.props;
const t = useTranslations(lang);
const homePath = lang === "en" ? "/en/" : "/";

const { contact } = siteSettings;

const socialLinks = [
  { label: "GitHub", url: contact.social.github },
  { label: "LinkedIn", url: contact.social.linkedin },
  { label: "Instagram", url: contact.social.instagram },
].filter((link) => link.url);

const emailUrl = contact.email ? `mailto:${contact.email}` : undefined;
---

<footer class="border-t border-border py-12">
  <Container>
    <div class="flex flex-col justify-between gap-8 pb-10 sm:flex-row sm:items-start">
      <div>
        <a href={homePath} class="font-heading text-2xl font-bold">
          marcos<span class="text-primary">.</span>reis
        </a>

        <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted">
          {t.footer.description}
        </p>
      </div>

      <nav
        class="flex flex-wrap gap-x-6 gap-y-3"
        aria-label={lang === "en" ? "Social media" : "Redes sociais"}
      >
        {socialLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium transition-colors hover:text-primary"
          >
            {link.label} ↗
          </a>
        ))}

        {emailUrl && (
          <a
            href={emailUrl}
            class="text-sm font-medium transition-colors hover:text-primary"
          >
            Email ↗
          </a>
        )}
      </nav>
    </div>

    <div class="flex flex-col justify-between gap-3 border-t border-border pt-5 font-mono text-[10px] text-muted sm:flex-row">
      <span>© {new Date().getFullYear()} Marcos Reis</span>
      <span>{t.footer.tagline}</span>
    </div>
  </Container>
</footer>
