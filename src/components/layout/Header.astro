
---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";

interface Props {
  lang?: "pt-br" | "en";
}

const { lang = "pt-br" } = Astro.props;

const isEnglish = lang === "en";

const navigation = isEnglish
  ? [
      { label: "Home", href: "#inicio" },
      { label: "Projects", href: "#projetos" },
      { label: "About", href: "#sobre" },
      { label: "Contact", href: "#contato" },
    ]
  : [
      { label: "Início", href: "#inicio" },
      { label: "Projetos", href: "#projetos" },
      { label: "Sobre mim", href: "#sobre" },
      { label: "Contato", href: "#contato" },
    ];
---

<header class="sticky top-0 z-50 border-b border-border bg-background">
  <Container className="flex min-h-19 items-center justify-between gap-6">
    <a
      href={isEnglish ? "/en/" : "/"}
      class="inline-flex shrink-0 items-center gap-2.5 font-heading text-lg font-bold"
      aria-label="Marcos Reis - Home"
    >
      <span class="grid size-9 place-items-center bg-foreground font-mono text-xs text-background">
        MR
      </span>

      <span>marcos<span class="text-primary">.</span>reis</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label={isEnglish ? "Main navigation" : "Navegação principal"}>
      {navigation.map((item) => (
        <a
          href={item.href}
          class="text-sm font-medium text-muted transition-colors hover:text-primary"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex shrink-0 items-center gap-4">
      <a
        href={isEnglish ? "/" : "/en/"}
        class="text-xs font-semibold text-muted transition-colors hover:text-primary"
        aria-label={isEnglish ? "Switch to Portuguese" : "Mudar para inglês"}
      >
        {isEnglish ? "PT" : "EN"}
      </a>

      <Button
        href="https://w.app/marcosvinireiss"
        external
        className="hidden px-4! py-3! text-xs sm:inline-flex"
      >
        {isEnglish ? "Let's talk" : "Vamos conversar"} ↗
      </Button>

      <details class="group relative md:hidden">
        <summary
          class="grid size-10 cursor-pointer list-none place-items-center border border-border text-foreground marker:hidden"
          aria-label={isEnglish ? "Open navigation" : "Abrir navegação"}
        >
          <span class="font-mono text-xl group-open:hidden">☰</span>
          <span class="hidden font-mono text-xl group-open:inline">×</span>
        </summary>

        <nav class="absolute right-0 top-14 flex min-w-52 flex-col border border-border bg-background p-3 shadow-lg">
          {navigation.map((item) => (
            <a
              href={item.href}
              class="px-3 py-3 text-sm font-medium text-muted transition-colors hover:bg-primary/5 hover:text-primary"
            >
              {item.label}
            </a>
          ))}

          <a
            href="https://w.app/marcosvinireiss"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 bg-primary px-3 py-3 text-sm font-semibold text-white"
          >
            {isEnglish ? "Let's talk ↗" : "Vamos conversar ↗"}
          </a>
        </nav>
      </details>
    </div>
  </Container>
</header>
