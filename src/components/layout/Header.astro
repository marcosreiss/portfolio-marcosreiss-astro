---
// Caminho: src/components/layout/Header.astro

import { siteSettings } from '@/data/site-settings';
import type { Language } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';

interface Props {
  lang?: Language;
  alternateUrl?: string;
}

const { lang = "pt-br", alternateUrl } = Astro.props;
const t = useTranslations(lang);

const isEnglish = lang === "en";
const homePath = isEnglish ? "/en/" : "/";
const isHome = Astro.url.pathname === homePath;

const navigation = [
  { label: t.nav.home, href: `${homePath}#inicio` },
  { label: t.nav.projects, href: `${homePath}#projetos` },
  { label: t.nav.about, href: `${homePath}#sobre` },
  { label: t.nav.contact, href: `${homePath}#contato` },
].map((item) => ({
  ...item,
  href: isHome ? item.href.replace(homePath, "") : item.href,
}));

const languageUrl = alternateUrl ?? (isEnglish ? "/" : "/en/");

const whatsappNumber = siteSettings.contact.whatsapp?.replace(/\D/g, "");
const whatsappUrl = whatsappNumber
  ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(siteSettings.contact.whatsappMessage || "")}`
  : undefined;
---

<header class="sticky top-0 z-50 border-b border-border bg-background">
  <Container className="flex min-h-19 items-center justify-between gap-4">
    <a
      href={homePath}
      class="inline-flex shrink-0 items-center gap-2.5 font-heading text-lg font-bold"
      aria-label="Marcos Reis - Home"
    >
      <span class="grid size-9 place-items-center bg-foreground font-mono text-xs text-background">
        MR
      </span>

      <span>marcos<span class="text-primary">.</span>reis</span>
    </a>

    <nav
      class="hidden items-center gap-8 md:flex"
      aria-label={isEnglish ? "Main navigation" : "Navegação principal"}
    >
      {navigation.map((item) => (
        <a
          href={item.href}
          class="text-sm font-medium text-muted transition-colors hover:text-primary"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex shrink-0 items-center gap-3">
      <a
        href={languageUrl}
        class="text-xs font-semibold text-muted transition-colors hover:text-primary"
        aria-label={t.nav.switchLanguage}
        title={t.nav.switchLanguage}
      >
        {isEnglish ? "PT" : "EN"}
      </a>

      <ThemeToggle />

      {whatsappUrl && (
        <Button
          href={whatsappUrl}
          external
          className="hidden px-4! py-3! text-xs sm:inline-flex"
        >
          {t.nav.talk} ↗
        </Button>
      )}

      <details class="group relative md:hidden">
        <summary
          class="grid size-10 cursor-pointer list-none place-items-center border border-border text-foreground marker:hidden"
          aria-label={isEnglish ? "Open navigation" : "Abrir navegação"}
        >
          <span class="font-mono text-xl group-open:hidden">☰</span>
          <span class="hidden font-mono text-xl group-open:inline">×</span>
        </summary>

        <nav class="absolute right-0 top-14 flex min-w-56 flex-col border border-border bg-background p-3 shadow-lg">
          {navigation.map((item) => (
            <a
              href={item.href}
              class="px-3 py-3 text-sm font-medium text-muted transition-colors hover:bg-primary/5 hover:text-primary"
            >
              {item.label}
            </a>
          ))}

          {whatsappUrl && (
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-2 bg-primary px-3 py-3 text-sm font-semibold text-white"
            >
              {t.nav.talk} ↗
            </a>
          )}
        </nav>
      </details>
    </div>
  </Container>
</header>
