
---
// Caminho: src/components/layout/Header.astro

import { siteSettings } from "@/data/site-settings";
import type { Language } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";

import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import ThemeToggle from "../ui/ThemeToggle.astro";
import { ArrowUpRight } from "lucide-react";

interface Props {
  lang?: Language;
  alternateUrl?: string;
}

const { lang = "pt-br", alternateUrl } = Astro.props;
const t = useTranslations(lang);

const isEnglish = lang === "en";
const homePath = isEnglish ? "/en/" : "/";
const isHome = Astro.url.pathname === homePath;

const navigation = [
  { label: t.nav.home, href: `${homePath}#inicio` },
  { label: t.nav.projects, href: `${homePath}#projetos` },
  { label: t.nav.about, href: `${homePath}#sobre` },
  { label: t.nav.contact, href: `${homePath}#contato` },
].map((item) => ({
  ...item,
  href: isHome ? item.href.replace(homePath, "") : item.href,
}));

const languageUrl = alternateUrl ?? (isEnglish ? "/" : "/en/");

const whatsappNumber = siteSettings.contact.whatsapp?.replace(/\D/g, "");
const whatsappUrl = whatsappNumber
  ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(siteSettings.contact.whatsappMessage || "")}`
  : undefined;

const logoLight = siteSettings.branding.logoLight;
const logoDark = siteSettings.branding.logoDark;
---

<header class="sticky top-0 z-50 border-b border-border bg-background">
  <Container className="flex min-h-19 items-center justify-between gap-4">
    <a
      href={homePath}
      class="inline-flex shrink-0 items-center gap-2.5"
      aria-label="Marcos Reis - Home"
    >
      {logoLight && logoDark ? (
        <span class="site-logo">
          <img
            src={logoLight}
            alt="Marcos Reis"
            class="site-logo-light"
          />

          <img
            src={logoDark}
            alt="Marcos Reis"
            class="site-logo-dark"
          />
        </span>
      ) : (
        <span class="font-bold text-primary-text">
          marcosvinireiss
        </span>
      )}
    </a>

    <nav
      class="hidden items-center gap-8 md:flex"
      aria-label={isEnglish ? "Main navigation" : "Navegação principal"}
    >
      {navigation.map((item) => (
        <a
          href={item.href}
          class="text-sm font-medium text-muted transition-colors hover:text-primary-text"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex shrink-0 items-center gap-3">
      <a
        href={languageUrl}
        class="text-xs font-semibold text-muted transition-colors hover:text-primary-text"
        aria-label={t.nav.switchLanguage}
        title={t.nav.switchLanguage}
      >
        {isEnglish ? "PT" : "EN"}
      </a>

      <ThemeToggle />

      {whatsappUrl && (
        <Button
          href={whatsappUrl}
          external
          className="hidden min-w-45 px-4! py-3! text-xs sm:inline-flex"
        >
        {t.nav.talk} <ArrowUpRight className="h-5 w-5"  />
        </Button>
      )}

      <details class="group relative md:hidden">
        <summary
          class="grid size-10 cursor-pointer list-none place-items-center border border-border text-foreground marker:hidden"
          aria-label={isEnglish ? "Open navigation" : "Abrir navegação"}
        >
          <span class="font-mono text-xl group-open:hidden">☰</span>
          <span class="hidden font-mono text-xl group-open:inline">×</span>
        </summary>

        <nav class="absolute right-0 top-14 flex min-w-56 flex-col border border-border bg-background p-3 shadow-lg">
          {navigation.map((item) => (
            <a
              href={item.href}
              class="px-3 py-3 text-sm font-medium text-muted transition-colors hover:bg-primary-soft hover:text-primary-text"
            >
              {item.label}
            </a>
          ))}

          {whatsappUrl && (
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-2 bg-primary px-3 py-3 text-sm font-semibold text-on-primary"
            >
              {t.nav.talk} ↗
            </a>
          )}
        </nav>
      </details>
    </div>
  </Container>
</header>

<style>
  .site-logo {
    position: relative;
    display: block;
    width: auto;
    height: 36px;
  }

  .site-logo img {
    display: block;
    width: auto;
    height: 36px;
    object-fit: contain;
  }

  .site-logo-dark {
    display: none !important;
  }

  :global(html.dark) .site-logo-light {
    display: none !important;
  }

  :global(html.dark) .site-logo-dark {
    display: block !important;
  }
</style>
