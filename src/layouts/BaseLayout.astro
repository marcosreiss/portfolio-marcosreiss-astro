---
import "@/styles/global.css";

import Analytics from "@vercel/analytics/astro";

import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import SkipLink from "../components/ui/SkipLink.astro";

import type { Language } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
  lang?: Language;
  image?: string;
  alternateUrl?: string;
  noindex?: boolean;
}

const {
  title = "Marcos Reis | Desenvolvedor Full Stack",
  description = "Desenvolvedor Full Stack que transforma ideias e necessidades de negócio em soluções digitais funcionais, modernas e escaláveis.",
  lang = "pt-br",
  image = "/og-image.png",
  alternateUrl,
  noindex = false,
} = Astro.props;

const htmlLang = lang === "pt-br" ? "pt-BR" : "en";

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.href;

const siteUrl = Astro.site?.href ?? new URL("/", Astro.url).href;

const alternateCanonical =
  alternateUrl && Astro.site
    ? new URL(alternateUrl, Astro.site).href
    : undefined;

const portugueseUrl =
  lang === "pt-br" ? canonical : alternateCanonical;

const englishUrl =
  lang === "en" ? canonical : alternateCanonical;

const ogImage = image
  ? new URL(image, Astro.site ?? Astro.url).href
  : undefined;

const personId = `${siteUrl}#person`;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: "Marcos Reis",
      url: siteUrl,
      jobTitle:
        lang === "en"
          ? "Full Stack Developer"
          : "Desenvolvedor Full Stack",
      sameAs: [
        "https://github.com/marcosreiss",
        "https://www.linkedin.com/in/marcosvinireis/",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: "Marcos Reis | Desenvolvedor Full Stack",
      inLanguage: htmlLang,
      publisher: {
        "@id": personId,
      },
    },
  ],
};

const structuredDataJson = JSON.stringify(structuredData).replace(
  /</g,
  "\\u003c",
);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content={description} />
    <meta name="author" content="Marcos Reis" />
    <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large"} />
    <meta name="theme-color" content="#F7F8FA" />

    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {portugueseUrl && (
      <link rel="alternate" hreflang="pt-BR" href={portugueseUrl} />
    )}

    {englishUrl && (
      <link rel="alternate" hreflang="en" href={englishUrl} />
    )}

    {portugueseUrl && (
      <link rel="alternate" hreflang="x-default" href={portugueseUrl} />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Marcos Reis" />
    <meta property="og:locale" content={lang === "pt-br" ? "pt_BR" : "en_US"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:secure_url" content={ogImage} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={title} />
      </>
    )}

    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <script
      type="application/ld+json"
      set:html={structuredDataJson}
    />

    
<script is:inline>
  (() => {
    const STORAGE_KEY = "portfolio-theme";
    const root = document.documentElement;
    const media = window.matchMedia("(prefers-color-scheme: dark)");
    const themeColor = document.querySelector('meta[name="theme-color"]');

    let manualTheme = null;

    function readPreference() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);

        return saved === "dark" || saved === "light"
          ? saved
          : null;
      } catch {
        return null;
      }
    }

    function applyTheme(theme) {
      const isDark = theme === "dark";

      root.classList.toggle("dark", isDark);
      root.classList.toggle("light", !isDark);

      themeColor?.setAttribute(
        "content",
        isDark ? "#101216" : "#F7F8FA",
      );
    }

    function getSystemTheme() {
      return media.matches ? "dark" : "light";
    }

    manualTheme = readPreference();

    applyTheme(manualTheme ?? getSystemTheme());

    // Acompanha mudanças no tema do sistema enquanto
    // não existir uma preferência manual.
    media.addEventListener("change", () => {
      if (!manualTheme) {
        applyTheme(getSystemTheme());
      }
    });

    // Alternância manual do tema.
    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;

      if (!event.target.closest("#theme-toggle")) return;

      const nextTheme = root.classList.contains("dark")
        ? "light"
        : "dark";

      manualTheme = nextTheme;
      applyTheme(nextTheme);

      try {
        localStorage.setItem(STORAGE_KEY, nextTheme);
      } catch {
        // A alternância continua funcionando nesta sessão.
      }
    });

    // Sincroniza a preferência entre abas.
    window.addEventListener("storage", (event) => {
      if (event.key !== STORAGE_KEY) return;

      manualTheme =
        event.newValue === "dark" || event.newValue === "light"
          ? event.newValue
          : null;

      applyTheme(manualTheme ?? getSystemTheme());
    });
  })();
</script>


    <title>{title}</title>
  </head>

  <body class="flex min-h-screen flex-col bg-background font-sans text-foreground antialiased">
    <Analytics />

    <SkipLink />
    <Header lang={lang} alternateUrl={alternateUrl} />

    <main class="flex-1">
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>
