---
// Caminho: src/layouts/BaseLayout.astro

import "@/styles/global.css";

import Analytics from "@vercel/analytics/astro";

import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";

import type { Language } from "@/i18n/ui";
import { siteSettings } from "@/data/site-settings";

interface Props {
  title?: string;
  description?: string;
  lang?: Language;
  image?: string;
  alternateUrl?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  lang = "pt-br",
  image,
  alternateUrl,
  noindex = false,
} = Astro.props;

const { personal, contact, branding, seo } = siteSettings;

const pageTitle = title || seo.siteTitle;
const pageDescription = description || seo.siteDescription;
const ogImagePath = image || branding.defaultOgImage;
const faviconPath = branding.favicon;

const htmlLang = lang === "pt-br" ? "pt-BR" : "en";
const ogLocale = lang === "pt-br" ? "pt_BR" : "en_US";

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.href;

const siteUrl = Astro.site?.href ?? new URL("/", Astro.url).href;

const alternateCanonical =
  alternateUrl && Astro.site
    ? new URL(alternateUrl, Astro.site).href
    : undefined;

const portugueseUrl =
  lang === "pt-br" ? canonical : alternateCanonical;

const englishUrl =
  lang === "en" ? canonical : alternateCanonical;

const ogImage = ogImagePath
  ? new URL(ogImagePath, Astro.site ?? Astro.url).href
  : undefined;

const favicon = faviconPath
  ? new URL(faviconPath, Astro.site ?? Astro.url).href
  : undefined;

  const faviconHref = branding.favicon || "/favicon.svg";
const faviconType = faviconHref.endsWith(".svg")
  ? "image/svg+xml"
  : faviconHref.endsWith(".png")
    ? "image/png"
    : "image/x-icon";


const personId = `${siteUrl}#person`;

const socialProfiles = [
  contact.social.github,
  contact.social.linkedin,
  contact.social.instagram,
].filter((url): url is string => Boolean(url));

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: personal.professionalName,
      url: siteUrl,
      jobTitle:
        personal.professionalTitle ||
        (lang === "en"
          ? "Full Stack Developer"
          : "Desenvolvedor Full Stack"),
      description: personal.shortBio || pageDescription,
      sameAs: socialProfiles,
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: seo.siteTitle,
      description: seo.siteDescription,
      inLanguage: htmlLang,
      publisher: {
        "@id": personId,
      },
    },
  ],
};

const structuredDataJson = JSON.stringify(structuredData).replace(
  /</g,
  "\\u003c",
);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content={pageDescription} />
    <meta name="author" content={personal.professionalName} />
    <meta
      name="robots"
      content={noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large"}
    />
    <meta name="theme-color" content="#F7F8FA" />

    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    {favicon && <link rel="icon" href={faviconHref} type={faviconType} />}

    {portugueseUrl && (
      <link rel="alternate" hreflang="pt-BR" href={portugueseUrl} />
    )}

    {englishUrl && (
      <link rel="alternate" hreflang="en" href={englishUrl} />
    )}

    {portugueseUrl && (
      <link rel="alternate" hreflang="x-default" href={portugueseUrl} />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={seo.siteTitle} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />

    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:secure_url" content={ogImage} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={pageTitle} />
      </>
    )}

    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <script
      type="application/ld+json"
      set:html={structuredDataJson}
    />

    <script is:inline>
      (() => {
        const STORAGE_KEY = "portfolio-theme";
        const root = document.documentElement;
        const media = window.matchMedia("(prefers-color-scheme: dark)");

        let manualTheme = null;

        function readPreference() {
          try {
            const saved = localStorage.getItem(STORAGE_KEY);

            return saved === "dark" || saved === "light"
              ? saved
              : null;
          } catch {
            return null;
          }
        }

        function syncToggleButtons(theme) {
          document.querySelectorAll("[data-theme-toggle]").forEach((toggle) => {
            const label =
              theme === "dark"
                ? toggle.dataset.labelLight
                : toggle.dataset.labelDark;

            if (label) {
              toggle.setAttribute("aria-label", label);
              toggle.title = label;
            }

            toggle.setAttribute("aria-pressed", String(theme === "dark"));
          });
        }

        function applyTheme(theme) {
          root.classList.toggle("dark", theme === "dark");
          root.classList.toggle("light", theme === "light");

          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute(
              "content",
              theme === "dark" ? "#101216" : "#F7F8FA",
            );

          syncToggleButtons(theme);
        }

        function getSystemTheme() {
          return media.matches ? "dark" : "light";
        }

        manualTheme = readPreference();

        applyTheme(manualTheme ?? getSystemTheme());

        document.addEventListener("click", (event) => {
          if (!(event.target instanceof Element)) return;

          const toggle = event.target.closest("[data-theme-toggle]");

          if (!toggle) return;

          const nextTheme = root.classList.contains("dark")
            ? "light"
            : "dark";

          manualTheme = nextTheme;

          try {
            localStorage.setItem(STORAGE_KEY, nextTheme);
          } catch {
            // Continua funcionando sem persistência.
          }

          applyTheme(nextTheme);
        });

        media.addEventListener("change", () => {
          if (!manualTheme) {
            applyTheme(getSystemTheme());
          }
        });

        window.addEventListener("storage", (event) => {
          if (event.key !== STORAGE_KEY) return;

          manualTheme =
            event.newValue === "dark" || event.newValue === "light"
              ? event.newValue
              : null;

          applyTheme(manualTheme ?? getSystemTheme());
        });

        document.addEventListener("DOMContentLoaded", () => {
          syncToggleButtons(root.classList.contains("dark") ? "dark" : "light");
        });

        document.addEventListener("astro:page-load", () => {
          syncToggleButtons(root.classList.contains("dark") ? "dark" : "light");
        });
      })();
    </script>

    <title>{pageTitle}</title>
  </head>

  <body class="flex min-h-screen flex-col bg-background font-sans text-foreground antialiased">
    <Analytics />

    <Header lang={lang} alternateUrl={alternateUrl} />

    <main class="flex-1">
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>
