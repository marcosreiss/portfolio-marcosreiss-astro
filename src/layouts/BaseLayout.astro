---
// Caminho: src/layouts/BaseLayout.astro

import "@/styles/global.css";

import Analytics from "@vercel/analytics/astro";

import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";

import type { Language } from "@/i18n/ui";
import { siteSettings } from "@/data/site-settings";

interface Props {
  title?: string;
  description?: string;
  lang?: Language;
  image?: string;
  imageSize?: { width: number; height: number };
  alternateUrl?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  lang = "pt-br",
  image,
  imageSize,
  alternateUrl,
  noindex = false,
} = Astro.props;

const { personal, contact, location, branding, seo, analytics } = siteSettings;

const pageTitle = title || seo.siteTitle;
const pageDescription = description || seo.siteDescription;

const htmlLang = lang === "pt-br" ? "pt-BR" : "en";
const ogLocale = lang === "pt-br" ? "pt_BR" : "en_US";
const ogLocaleAlternate = lang === "pt-br" ? "en_US" : "pt_BR";

const base = Astro.site ?? Astro.url;

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.href;

const siteUrl = Astro.site?.href ?? new URL("/", Astro.url).href;

const alternateCanonical =
  alternateUrl && Astro.site
    ? new URL(alternateUrl, Astro.site).href
    : undefined;

const portugueseUrl = lang === "pt-br" ? canonical : alternateCanonical;
const englishUrl = lang === "en" ? canonical : alternateCanonical;

function mimeFromPath(path: string): string | undefined {
  const clean = path.split("?")[0].toLowerCase();
  if (clean.endsWith(".svg")) return "image/svg+xml";
  if (clean.endsWith(".png")) return "image/png";
  if (clean.endsWith(".jpg") || clean.endsWith(".jpeg")) return "image/jpeg";
  if (clean.endsWith(".webp")) return "image/webp";
  if (clean.endsWith(".avif")) return "image/avif";
  if (clean.endsWith(".ico")) return "image/x-icon";
  return undefined;
}

const ogImagePath = image || branding.defaultOgImage;
const ogImage = ogImagePath ? new URL(ogImagePath, base).href : undefined;
const ogImageType = ogImagePath ? mimeFromPath(ogImagePath) : undefined;

// Favicon: caminho relativo direto, sem new URL.
// Funciona igual em localhost e em produção.
const faviconHref = branding.favicon || "/favicon.svg";
const faviconType = mimeFromPath(faviconHref);

const personId = `${siteUrl}#person`;

const socialProfiles = [
  contact.social.github,
  contact.social.linkedin,
  contact.social.instagram,
].filter((url): url is string => Boolean(url));

const languageNames: Record<string, string> = {
  pt: "Portuguese",
  en: "English",
  es: "Spanish",
};

const hasAddress = Boolean(location.city || location.state || location.country);

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: personal.professionalName,
      url: siteUrl,
      jobTitle:
        personal.professionalTitle ||
        (lang === "en" ? "Full Stack Developer" : "Desenvolvedor Full Stack"),
      description: personal.shortBio || seo.siteDescription,
      ...(contact.email && { email: contact.email }),
      ...(ogImage && { image: ogImage }),
      ...(hasAddress && {
        address: {
          "@type": "PostalAddress",
          ...(location.city && { addressLocality: location.city }),
          ...(location.state && { addressRegion: location.state }),
          ...(location.country && { addressCountry: location.country }),
        },
      }),
      knowsLanguage: location.languages.map((l) => languageNames[l] ?? l),
      sameAs: socialProfiles,
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: seo.siteTitle,
      description: seo.siteDescription,
      inLanguage: htmlLang,
      publisher: { "@id": personId },
    },
  ],
};

const structuredDataJson = JSON.stringify(structuredData).replace(
  /</g,
  "\\u003c",
);

const gaId = analytics.googleAnalyticsId?.trim();
const pixelId = analytics.metaPixelId?.trim();

const gaInit = gaId
  ? `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config',${JSON.stringify(gaId)});`
  : "";

const pixelInit = pixelId
  ? `!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init',${JSON.stringify(pixelId)});fbq('track','PageView');`
  : "";
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={personal.professionalName} />
    <meta
      name="robots"
      content={noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large"}
    />
    <meta name="theme-color" content="Canvas" />

    <link rel="canonical" href={canonical} />
    {Astro.site && (
      <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    )}

    <link rel="icon" href={faviconHref} type={faviconType} />

    {portugueseUrl && (
      <link rel="alternate" hreflang="pt-BR" href={portugueseUrl} />
    )}
    {englishUrl && <link rel="alternate" hreflang="en" href={englishUrl} />}
    {portugueseUrl && (
      <link rel="alternate" hreflang="x-default" href={portugueseUrl} />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={seo.siteTitle} />
    <meta property="og:locale" content={ogLocale} />
    {alternateCanonical && (
      <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    )}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />

    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:secure_url" content={ogImage} />
        {ogImageType && <meta property="og:image:type" content={ogImageType} />}
        {imageSize && (
          <>
            <meta property="og:image:width" content={String(imageSize.width)} />
            <meta property="og:image:height" content={String(imageSize.height)} />
          </>
        )}
        <meta property="og:image:alt" content={pageTitle} />
      </>
    )}

    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImage && (
      <>
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:image:alt" content={pageTitle} />
      </>
    )}

    <script type="application/ld+json" set:html={structuredDataJson} />

    {gaId && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
        ></script>
        <script is:inline set:html={gaInit} />
      </>
    )}

    {pixelId && <script is:inline set:html={pixelInit} />}

    <script is:inline>
      (() => {
        const STORAGE_KEY = "portfolio-theme";
        const root = document.documentElement;
        const media = window.matchMedia("(prefers-color-scheme: dark)");

        let manualTheme = null;

        function readPreference() {
          try {
            const saved = localStorage.getItem(STORAGE_KEY);
            return saved === "dark" || saved === "light" ? saved : null;
          } catch {
            return null;
          }
        }

        function syncToggleButtons(theme) {
          document.querySelectorAll("[data-theme-toggle]").forEach((toggle) => {
            const label =
              theme === "dark"
                ? toggle.dataset.labelLight
                : toggle.dataset.labelDark;

            if (label) {
              toggle.setAttribute("aria-label", label);
              toggle.title = label;
            }

            toggle.setAttribute("aria-pressed", String(theme === "dark"));
          });
        }

        function applyTheme(theme) {
          root.classList.toggle("dark", theme === "dark");
          root.classList.toggle("light", theme === "light");

          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute(
              "content",
              getComputedStyle(document.documentElement).getPropertyValue("--background").trim(),
            );

          syncToggleButtons(theme);
        }

        function getSystemTheme() {
          return media.matches ? "dark" : "light";
        }

        manualTheme = readPreference();
        applyTheme(manualTheme ?? getSystemTheme());

        document.addEventListener("click", (event) => {
          if (!(event.target instanceof Element)) return;

          const toggle = event.target.closest("[data-theme-toggle]");
          if (!toggle) return;

          const nextTheme = root.classList.contains("dark") ? "light" : "dark";
          manualTheme = nextTheme;

          try {
            localStorage.setItem(STORAGE_KEY, nextTheme);
          } catch {
            // Continua funcionando sem persistência.
          }

          applyTheme(nextTheme);
        });

        media.addEventListener("change", () => {
          if (!manualTheme) applyTheme(getSystemTheme());
        });

        window.addEventListener("storage", (event) => {
          if (event.key !== STORAGE_KEY) return;

          manualTheme =
            event.newValue === "dark" || event.newValue === "light"
              ? event.newValue
              : null;

          applyTheme(manualTheme ?? getSystemTheme());
        });

        const resync = () =>
          syncToggleButtons(root.classList.contains("dark") ? "dark" : "light");

        document.addEventListener("DOMContentLoaded", resync);
        document.addEventListener("astro:page-load", resync);
      })();
    </script>
  </head>

  <body class="flex min-h-screen flex-col bg-background font-sans text-foreground antialiased">
    <Analytics />

    <Header lang={lang} alternateUrl={alternateUrl} />

    <main class="flex-1">
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>
