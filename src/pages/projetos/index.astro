---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import ProjectCard from "../../features/projects/components/ProjectCard.astro";

import { useTranslations } from "../../i18n/utils";
import { getDateTimestamp, getLatestDate } from "../../utils/date";

const lang = "pt-br";
const t = useTranslations(lang);

const projects = await getCollection(
  "projects",
  ({ data }) => data.published,
);

const sortedProjects = [...projects].sort((a, b) => {
  const dateA = getLatestDate(a.data.startDate, a.data.endDate);
  const dateB = getLatestDate(b.data.startDate, b.data.endDate);

  return getDateTimestamp(dateB) - getDateTimestamp(dateA);
});
---

<BaseLayout
  lang={lang}
  alternateUrl="/en/projects/"
  title="Projetos | Marcos Reis"
  description="Conheça os projetos e soluções digitais desenvolvidos por Marcos Reis."
>
  <section class="py-20 sm:py-28">
    <Container>
      <div class="max-w-3xl">
        <span class="font-mono text-[11px] tracking-wider text-muted">
          {t.projects.listingEyebrow}
        </span>

        <h1 class="mt-6 font-heading text-5xl font-semibold leading-tight tracking-[-0.06em] sm:text-6xl lg:text-7xl">
          {t.projects.listingTitle}
          <span class="text-primary-text"> {t.projects.listingHighlight}</span>
        </h1>

        <p class="mt-7 max-w-xl text-sm leading-8 text-muted sm:text-base">
          {t.projects.listingDescription}
        </p>

        <div class="mt-8">
          <Button href="/" variant="secondary">
            ← {t.projects.back}
          </Button>
        </div>
      </div>

      <div class="mb-8 mt-20 flex items-center justify-between border-b border-border pb-4">
        <span class="font-mono text-[10px] tracking-wider text-muted">
          {t.projects.allProjects}
        </span>

        <span class="font-mono text-[11px] text-primary-text">
          {String(sortedProjects.length).padStart(2, "0")} {t.projects.results}
        </span>
      </div>

      {sortedProjects.length > 0 ? (
        <div class="grid grid-cols-1 gap-x-7 gap-y-14 md:grid-cols-2">
          {sortedProjects.map((project) => (
            <ProjectCard project={project} lang={lang} />
          ))}
        </div>
      ) : (
        <div class="border border-border py-20 text-center">
          <p class="text-sm text-muted">{t.projects.empty}</p>
        </div>
      )}
    </Container>
  </section>
</BaseLayout>
