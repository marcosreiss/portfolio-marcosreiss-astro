---

import BaseLayout from "../../layouts/BaseLayout.astro";

import Hero from "@/features/home/components/hero/Hero.astro";
import Services from "@/features/home/components/services/Services.astro";
import Projects from "@/features/home/components/projects/Projects.astro";
import About from "@/features/home/components/about/About.astro";
import Contact from "@/features/home/components/contact/Contact.astro";
import Process from "@/features/home/components/process/Process.astro";
import Testimonials from "@/features/home/components/testimonials/Testimonials.astro";
import Credibility from "@/features/home/components/credibility/Credibility.astro";



const lang = "en";

---

<BaseLayout
  lang={lang}
  alternateUrl="/"
  title="Marcos Reis | Full Stack Developer"
  description="Full Stack Developer building functional, modern, and scalable digital solutions."
>
  <Hero lang={lang} />
  <Credibility lang={lang} />
  <Services lang={lang} />
  <Projects  lang={lang} />
  <Process lang={lang} />
  <About lang={lang} />
  <Testimonials lang={lang} />
  <Contact lang={lang} />
</BaseLayout>
