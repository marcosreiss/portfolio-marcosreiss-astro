---

import BaseLayout from "../../layouts/BaseLayout.astro";

import Services from "../../features/home/components/Services.astro";
import Projects from "../../features/home/components/Projects.astro";
import About from "../../features/home/components/About.astro";
import Contact from "../../features/home/components/Contact.astro";
import Hero from "@/features/home/components/hero/Hero.astro";
import CredibilitySection from "@/features/home/components/CredibilitySection.astro";
import Process from "@/features/home/components/Process.astro";
import Testimonials from "@/features/home/components/Testimonials.astro";


const lang = "en";

---

<BaseLayout
  lang={lang}
  alternateUrl="/"
  title="Marcos Reis | Full Stack Developer"
  description="Full Stack Developer building functional, modern, and scalable digital solutions."
>
  <Hero lang={lang} />
  <CredibilitySection lang={lang} />
  <Services lang={lang} />
  <Projects lang={lang} />
  <Process lang={lang} />
  <About lang={lang} />
  <Testimonials lang={lang} />
  <Contact lang={lang} />
</BaseLayout>
